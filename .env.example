# Base de Datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/eli"

# NextAuth.js
# URL de tu aplicación
NEXTAUTH_URL="http://localhost:3000"

# Secreto para NextAuth (genera uno con: openssl rand -base64 32)
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-seguro"

# Environment
NODE_ENV="development"

# URL pública del sitio (sitemap, redirects de Stripe checkout)
NEXT_PUBLIC_BASE_URL="https://useeli.com"

# Resend — emails de confirmación y recordatorio
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Eli <no-reply@useeli.com>"

# Twilio — confirmación y recordatorio por WhatsApp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="+14155238886"

# Stripe — checkout y webhook de suscripciones
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""

# Cron de recordatorios — Vercel envía "Authorization: Bearer $CRON_SECRET"
# automáticamente cuando esta variable está configurada en el proyecto
CRON_SECRET="genera-uno-con-openssl-rand-base64-32"
