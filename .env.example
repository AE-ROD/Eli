# Base de Datos PostgreSQL
# En local: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
#
# En producción con Neon/Supabase (recomendado), usar DOS URLs distintas:
# - DATABASE_URL: la conexión "pooled" (con pgbouncer) — la usa la app en cada
#   request. Sin esto, cada función serverless abre su propia conexión a
#   Postgres y con tráfico real se agotan las conexiones disponibles.
# - DIRECT_URL: la conexión directa (sin pooler) — la usa Prisma solo para
#   correr migraciones (`prisma migrate deploy`).
# Ambas las da el proveedor (en Neon: "Pooled connection" vs "Direct connection";
# en Supabase: puerto 6543 con ?pgbouncer=true vs puerto 5432).
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/eli"
DIRECT_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/eli"

# NextAuth.js
# URL de tu aplicación
NEXTAUTH_URL="http://localhost:3000"

# Secreto para NextAuth (genera uno con: openssl rand -base64 32)
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-seguro"

# Google OAuth (login con Google)
# Crear credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (envío de emails: confirmaciones, avisos, invitaciones, recordatorios)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Eli <no-reply@eli.app>"

# Secreto para autorizar el cron de recordatorios (/api/cron/recordatorios)
# Debe coincidir con el header x-cron-secret que envía el proveedor del cron
CRON_SECRET="genera-un-secreto-aleatorio"

# Upstash Redis (rate limiting de login, registro y reserva pública)
# Crear una base gratuita en https://console.upstash.com/ → Redis → Create Database
# Copiar "REST URL" y "REST TOKEN" desde el panel de la base.
# Si se dejan vacías, el rate limiting queda desactivado (no rompe el desarrollo local).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Environment
NODE_ENV="development"
