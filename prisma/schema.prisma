generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  password             String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  /// Las sesiones iniciadas antes de este momento ya no valen: lo pone
  /// restablecer la contraseña. `lib/auth.ts` lo revisa cada 5 minutos. Null es
  /// "nunca se cerraron". Columna en camelCase y sin `@map`, como el resto del
  /// modelo (`createdAt`, `updatedAt`).
  sesionesValidasDesde DateTime?
  /// Baja de los correos del ciclo de prueba (bienvenida, consejo, avisos de
  /// fin). No afecta los correos de la cuenta (recuperar contraseña, etc.).
  correosDesactivados  Boolean   @default(false)

  business             Business?
  memberships          BusinessMember[]
  resetTokens          PasswordResetToken[]
  commissionChanges    CommissionChange[] // cambios de porcentaje que este usuario (siempre dueño) aplicó.
  // Relación opcional (ver CommissionChange.changedById): la auditoría no
  // puede depender de que el usuario siga existiendo.
  solicitudesDeSoporte SolicitudDeSoporte[] // relación opcional: la solicitud queda si se borra el usuario.

  @@map("usuarios")
}

model Business {
  id        String   @id @default(cuid())
  name      String
  type      String // id de `lib/rubros.ts` (o uno viejo: salud, fitness, otro); CHECK en la base
  slug      String   @unique
  teamSize  Int      @default(1)
  /// Zona IANA del negocio: en ella se leen sus horarios "HH:MM" y sus días
  /// (lib/zona-horaria.ts). Todavía no hay pantalla para cambiarla.
  timezone  String   @default("America/Santiago")
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cuándo termina la prueba gratis. Lo fija el código al crear el negocio
  /// (`finDeLaPrueba` en `lib/prueba.ts`) y lo corre un referido. Sin default a
  /// propósito: un `now()` mentiría; la migración rellenó createdAt + 7 días.
  pruebaTerminaEl         DateTime
  /// Si el negocio recibe los correos del ciclo de prueba. Los negocios que ya
  /// existían al agregarse quedaron en false (la migración): no se les manda una
  /// bienvenida tardía.
  recibeCorreosDePrueba   Boolean   @default(true)
  /// Cuándo se copió por primera vez el enlace de reservas (lista "Deja tu
  /// negocio listo").
  enlaceCompartidoAt      DateTime?
  /// Código del enlace de invitación: aleatorio, no adivinable y distinto del
  /// slug. Lo genera `generarCodigoInvitacion` (`lib/prueba.ts`).
  codigoInvitacion        String    @unique
  /// El negocio que invitó a éste, si llegó por un enlace de invitación.
  invitadoPorId           String?
  invitadoPor             Business? @relation("Referidos", fields: [invitadoPorId], references: [id], onDelete: SetNull)
  /// En el invitado: cuándo su primera reserva pública contó para quien lo
  /// invitó. No null = ya contó, y no vuelve a contar.
  referidoContabilizadoAt DateTime?
  /// En quien invita: cuándo recibió sus días extra por un referido. Se dan una
  /// sola vez en total por negocio.
  extensionPorReferidoAt  DateTime?

  // ─── Mini página pública (etapa 1) ──────────────────────────────────────
  // Datos que el negocio edita y que se muestran en /reservar/[slug]. Todos
  // opcionales: un negocio sin llenarlos se ve como hasta ahora.
  address               String?
  comuna                String?
  /// Número de WhatsApp del negocio, en E.164 (+56...). Lo valida la app.
  whatsapp              String?
  /// Usuario de Instagram, sin la URL.
  instagram             String?
  /// Clave de una paleta cerrada de colores; la lista válida está en la app,
  /// no en la base.
  color                 String?
  logoUrl               String?
  coverUrl              String?
  /// Ids de `lib/medios-de-pago.ts` que el negocio acepta, para mostrarlos en
  /// la página pública. Vacío = no se muestra nada.
  mediosDePago          String[] @default([])
  /// Hasta cuántas horas antes de la cita el cliente puede cancelar o
  /// reagendar con su enlace. Default 24; lo cambia el negocio, de 0 a 72
  /// (CHECK en la base).
  cancelacionHorasAntes Int      @default(24)

  // ─── La plata del equipo (etapa 2) ──────────────────────────────────────
  /// Cada cuánto se liquida al equipo: "semanal" | "quincenal" | "mensual".
  /// Lo elige sólo la dueña (`puedeConfigurarLiquidacion`). Un CHECK de la
  /// migración limita los valores. Cambiarlo sólo afecta lo que viene.
  liquidacionPeriodo      String    @default("mensual")
  /// En el período semanal, qué día empieza la semana (0 = domingo … 6 =
  /// sábado, como `WorkSchedule.dayOfWeek`). Default lunes. CHECK 0..6.
  liquidacionInicioSemana Int       @default(1)
  /// Desde qué día (del negocio, en su zona) se liquida: lo cobrado antes y
  /// los movimientos con fecha anterior nunca entran a una liquidación. Lo
  /// fija la dueña antes de la primera; null = todavía no se liquida. Se
  /// puede cambiar sólo mientras no haya liquidaciones no anuladas.
  liquidacionDesde        DateTime? @db.Date

  // ─── Avisos por correo a clientes (etapa 3) ─────────────────────────────
  /// Enlace para dejar una reseña en Google. Lo valida la app (https y un
  /// dominio de Google); null = no se piden reseñas aunque esté encendido.
  enlaceResenas       String?
  /// Interruptores de los mensajes a clientes. Los enciende sólo la dueña
  /// (`puedeActivarMensajesAClientes`). La lista de espera es servicio y viene
  /// encendida; "te toca" y las reseñas son promocionales y vienen apagadas.
  listaDeEsperaActiva Boolean @default(true)
  avisoDeVueltaActivo Boolean @default(false)
  pideResenas         Boolean @default(false)

  // ─── Reservas seguras y fila virtual (etapa 4) ──────────────────────────
  /// Con cuántas faltas ("no-asistio" de los últimos 365 días, por email o
  /// teléfono normalizado del contacto en este negocio) una reserva pública
  /// entra por confirmar (#84). Null = apagado (el default). CHECK 1..20. Lo
  /// configura sólo la dueña (`puedeConfigurarPorConfirmar`).
  porConfirmarTrasFaltas Int?
  /// Fila virtual (#85): si el negocio acepta que se anoten en `/fila/[slug]`.
  /// La enciende sólo la dueña (`puedeActivarFilaVirtual`).
  filaVirtualActiva      Boolean @default(false)
  /// Cuántas personas puede haber esperando en la fila a la vez. CHECK 1..100.
  filaVirtualTope        Int     @default(15)

  // ─── Reservas a medida (etapa 5) ────────────────────────────────────────
  /// Precios de hora valle (#89c): una opción del negocio, apagada por
  /// defecto. Las franjas están en `FranjaDeHoraValle`. La configura sólo la
  /// dueña (`puedeConfigurarHoraValle`).
  horaValleActiva Boolean @default(false)

  invitados                Business[]                     @relation("Referidos")
  correosDeCuenta          CorreoDeCuenta[]
  customers                Customer[]
  appointments             Appointment[]
  services                 Service[]
  workSchedules            WorkSchedule[]
  conversations            Conversation[]
  members                  BusinessMember[]
  invitations              WorkerInvitation[]
  visits                   Visit[]
  commissionRates          CommissionRate[]
  commissionChanges        CommissionChange[]
  solicitudesDeSoporte     SolicitudDeSoporte[]
  memberServices           MemberService[]
  timeBlocks               TimeBlock[]
  productos                Producto[]
  propinas                 PropinaDeAtencion[]
  liquidaciones            Liquidacion[]
  movimientosDeLiquidacion MovimientoDeLiquidacion[]
  cierresDeCaja            CierreDeCaja[]
  inscripcionesEnEspera    InscripcionEnEspera[]
  enviosAClientes          EnvioAClientes[]
  serviciosDeCitas         AppointmentService[]
  franjasDeHoraValle       FranjaDeHoraValle[]
  // Clínica dental (`type` "odontologia"). Las tablas existen para todo
  // negocio, pero sólo uno dental las usa: lo decide `lib/permisos.ts`.
  sillones                 Sillon[]
  fichasClinicas           FichaClinica[]
  marcasDentales           MarcaDental[]
  evoluciones              Evolucion[]
  planesDeTratamiento      PlanDeTratamiento[]
  etapasDelPlan            EtapaDelPlan[]
  prestacionesDelPlan      PrestacionDelPlan[]
  // Prótesis (clínica dental, etapa 7).
  laboratorios             Laboratorio[]
  materialesDeProtesis     MaterialDeProtesis[]
  excepcionesDeReparto     ExcepcionDeRepartoDeProtesis[]
  cambiosDeReparto         CambioDeRepartoDeProtesis[]
  protesis                 Protesis[]
  eventosDeProtesis        EventoDeProtesis[]
  pagosAlLaboratorio       PagoAlLaboratorio[]

  @@index([invitadoPorId])
  @@map("negocios")
}

/// Un correo del ciclo de prueba ya enviado a un negocio ("bienvenida",
/// "consejo", "quedan-3-dias", "termina-hoy"). El único por (negocio, tipo)
/// impide registrar, y por lo tanto mandar, dos veces el mismo.
model CorreoDeCuenta {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tipo       String
  enviadoAt  DateTime @default(now())

  @@unique([businessId, tipo])
  @@map("correos_de_cuenta")
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("worker") // "admin" | "worker" (CHECK en la base)
  createdAt  DateTime @default(now())

  // Porcentaje por defecto de comisión (0-100) -- el rango lo garantiza un
  // CHECK de la migración (`miembros_negocio_commissionPercent_check`), no
  // Prisma. Sin valor por defecto a propósito: `null` es "todavía no
  // configurado", no "0%". Segundo escalón de la cascada, detrás de
  // CommissionRate y delante de "pendiente de configurar".
  commissionPercent Float?

  /// Lo que se muestra del profesional en la página pública ("Colorista").
  especialidad String?
  fotoUrl      String?

  workSchedules            WorkSchedule[]
  appointments             Appointment[]
  visitServices            VisitService[]
  commissionRates          CommissionRate[]
  // Filas de auditoría donde este miembro es el auditado. La relación de
  // CommissionChange.member es simple (no compuesta) y SetNull: ver el
  // comentario en ese modelo.
  commissionChanges        CommissionChange[]
  // Servicios que hace este profesional. Sin filas = hace todos.
  memberServices           MemberService[]
  timeBlocks               TimeBlock[]
  propinas                 PropinaDeAtencion[]
  liquidaciones            Liquidacion[]
  movimientosDeLiquidacion MovimientoDeLiquidacion[]
  inscripcionesEnEspera    InscripcionEnEspera[]
  // Clínica dental: lo que escribió o atiende este odontólogo. FK compuestas
  // y NO ACTION, como las de la liquidación.
  evoluciones              Evolucion[]
  prestacionesDelPlan      PrestacionDelPlan[]
  // Prótesis: las que trata y sus excepciones de reparto. FK compuestas; la
  // de la prótesis es NO ACTION, la de la excepción CASCADE (como
  // CommissionRate).
  protesis                 Protesis[]
  excepcionesDeReparto     ExcepcionDeRepartoDeProtesis[]

  @@unique([businessId, userId])
  // Habilita la FK compuesta de CommissionRate (memberId, businessId): sin
  // esto Postgres no puede referenciar el par, y es lo único que impide que
  // una fila de comisión tenga el profesional de un negocio con el
  // businessId de otro.
  @@unique([id, businessId])
  @@index([businessId])
  @@index([userId])
  @@map("miembros_negocio")
}

model WorkerInvitation {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  name       String
  role       String    @default("worker") // "admin" | "worker" (CHECK en la base)
  /// sha256 del token del enlace (lib/tokens.ts); el token en claro no se
  /// guarda. La columna sigue llamándose `token` para no renombrarla.
  tokenHash  String    @unique @map("token")
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
  @@map("invitaciones")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 del token del enlace (lib/tokens.ts), como `WorkerInvitation.tokenHash`.
  tokenHash String    @unique @map("token")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("tokens_recuperacion")
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  lastName   String?
  cedula     String?
  email      String?
  phone      String?
  /// Default `{}` desde la migración `cierre_de_la_v1`, que también pasó a
  /// `{}` los NULL de antes (#160).
  tags       String[] @default([])
  notes      String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Consentimiento para escribirle por WhatsApp: cuándo se dio y por dónde
  /// ("reserva-publica" | "panel" | "importacion"; CHECK en la base). Null =
  /// sin consentimiento registrado.
  whatsappConsentAt     DateTime?
  whatsappConsentSource String?

  /// Consentimiento para los correos promocionales del negocio ("te toca" y
  /// pedir reseña): cuándo se dio y por dónde ("reserva-publica" | "panel",
  /// CHECK en la base). Vigente = `correoPromoConsentAt` no null. La baja (en
  /// un clic o pedida en el local) lo pone en null y anota `correoPromoBajaAt`;
  /// volver a marcar la casilla lo da de nuevo, con fecha y origen nuevos.
  correoPromoConsentAt     DateTime?
  correoPromoConsentSource String?
  correoPromoBajaAt        DateTime?

  appointments    Appointment[]
  visits          Visit[]
  enviosAClientes EnvioAClientes[]

  // Clínica dental: la ficha clínica del paciente. Todo con FK compuesta
  // (customerId, businessId) y Cascade.
  fichaClinica        FichaClinica?
  marcasDentales      MarcaDental[]
  evoluciones         Evolucion[]
  planesDeTratamiento PlanDeTratamiento[]
  protesis            Protesis[]

  @@unique([id, businessId])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@map("clientes")
}

model Service {
  id                  String   @id @default(cuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  duration            Int // en minutos: 15, 30, 45, 60, 90, 120... (CHECK > 0 en la base)
  price               Float?
  /// Categoría libre para agrupar en la página pública ("Corte", "Color").
  category            String?
  /// Cada cuántos días vuelve normalmente un cliente a este servicio, para
  /// "te toca" cuando el cliente no tiene ciclo propio. Null = no se avisa.
  /// CHECK 7..365 en la base.
  frecuenciaDias      Int?
  /// Hora valle (#89c): este servicio no se rebaja nunca, aunque la reserva
  /// caiga en una franja.
  excluidoDeHoraValle Boolean  @default(false)
  /// Clínica dental: el motivo es una urgencia. La reserva pública sólo
  /// ofrece horas de hoy para él, y el servidor lo vuelve a validar al
  /// confirmar. En los otros rubros queda en false y no se usa.
  esUrgencia          Boolean  @default(false)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  appointments          Appointment[]
  visitServices         VisitService[]
  commissionRates       CommissionRate[]
  // Filas de auditoría con este servicio como excepción puntual. Relación
  // simple (no compuesta) y SetNull: ver el comentario en CommissionChange.
  commissionChanges     CommissionChange[]
  memberServices        MemberService[]
  inscripcionesEnEspera InscripcionEnEspera[]
  serviciosDeCitas      AppointmentService[]
  // Prestaciones de planes de tratamiento que sugieren este servicio. FK
  // compuesta y NO ACTION: borrar un servicio que está en un plan falla
  // (P2003, el endpoint responde 409); se desactiva con `active`.
  prestacionesDelPlan   PrestacionDelPlan[]

  // Habilita la FK compuesta de CommissionRate (serviceId, businessId), igual
  // que en BusinessMember.
  @@unique([id, businessId])
  @@index([businessId])
  @@map("servicios")
}

model WorkSchedule {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId   String?
  member     BusinessMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Domingo, 1=Lunes, 2=Martes, 3=Miércoles, 4=Jueves, 5=Viernes, 6=Sábado (CHECK en la base)
  startTime  String // "09:00"
  endTime    String // "18:00"
  active     Boolean         @default(true)

  @@index([businessId])
  @@index([memberId])
  @@map("horarios_laborales")
}

model Appointment {
  id                    String          @id @default(cuid())
  serviceId             String?
  service               Service?        @relation(fields: [serviceId], references: [id])
  title                 String // nombre del servicio como texto libre o copia del servicio
  startTime             DateTime
  endTime               DateTime
  status                String          @default("pendiente") // pendiente, confirmada, en-progreso, completada, cancelada, no-asistio (`ESTADOS_DE_CITA`; CHECK en la base)
  // Quién creó la cita: "panel" (el equipo del negocio) o "reserva-publica"
  // (la página /reservar/[slug]). Los topes anti-abuso de la reserva pública
  // cuentan por esta columna (`lib/reserva-publica.ts`). En la base, una CHECK
  // la limita a esos dos valores (migración `origen_de_las_citas`).
  source                String          @default("panel")
  // Etapa 4 (#84): la reserva pública entró por confirmar porque el contacto
  // tenía `Business.porConfirmarTrasFaltas` faltas o más. Se fija al crearla y
  // no cambia: no es un estado. Toda reserva pública nace "pendiente", así que
  // el status solo no distingue; "por confirmar" es esta marca con status
  // "pendiente" (`estaPorConfirmar` en `lib/por-confirmar.ts`). La confirman o
  // cancelan dueña y encargado (`puedeResolverPorConfirmar`).
  confirmacionPorFaltas Boolean         @default(false)
  // Clínica dental: el paciente dijo en la reserva pública que es su primera
  // vez. La cita ya trae sumados los 15 minutos extra (los suma el servidor,
  // no el navegador); la marca queda para mostrarlo en la agenda.
  primeraVez            Boolean         @default(false)
  // Clínica dental: el sillón donde se atiende. Opcional: la reserva pública
  // no lo asigna, lo asigna la clínica. FK compuesta (sillonId, businessId)
  // contra `sillones`, así una cita nunca queda en el sillón de otro negocio.
  // NO ACTION y no Restrict: Restrict rompería el borrado en cascada del
  // negocio entero (la cascada puede llegar a `sillones` antes que a `citas`);
  // NO ACTION se revisa al final de la sentencia, cuando ya no queda ninguna
  // de las dos. Los sillones no se borran: se desactivan.
  sillonId              String?
  sillon                Sillon?         @relation(fields: [sillonId, businessId], references: [id, businessId], onDelete: NoAction)
  notes                 String? // notas internas del profesional
  clientComments        String? // comentarios del cliente al reservar
  price                 Float?
  // La columna sigue llamándose `patientId` en la base (de cuando Eli apuntaba a
  // consultorios). Renombrarla pide una migración sobre datos reales; el `@map`
  // deja el nombre claro en el código sin tocar la tabla.
  customerId            String?         @map("patientId")
  customer              Customer?       @relation(fields: [customerId], references: [id])
  memberId              String?
  member                BusinessMember? @relation(fields: [memberId], references: [id])
  businessId            String
  business              Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // SIN USO desde la etapa 2: la comisión se congela por línea, en
  // `VisitService` (commissionPercent/commissionCents/commissionAt), porque una
  // cita puede tener varias líneas de distintos profesionales. Estas columnas
  // quedan vacías y no se borran (borrarlas es una migración destructiva que
  // no hace falta). Lo que sigue es su diseño original.
  //
  // Comisión congelada al completar la cita. Todavía no hay código que la
  // calcule: estas columnas son sólo el lugar donde va a quedar. Se escriben
  // una sola vez y no se recalculan: cambiar un porcentaje después no puede
  // alterar una cita ya liquidada. Opcionales sin valor por defecto a propósito, por la misma
  // razón que en BusinessMember/CommissionRate: `null` tiene que poder
  // significar "todavía no tiene comisión resuelta", nunca "0".
  //
  // Los tres son NULL juntos o NOT NULL juntos: lo garantiza un CHECK de la
  // migración (`citas_comision_congelada_check`), no Prisma. Sin esto, una
  // cita podría quedar con `commissionAmount = 0` y `commissionPercent = NULL`
  // ("pendiente de configurar") y liquidarse como si valiera cero sin que
  // nadie lo note.
  //
  // `commissionAmount` es `Decimal`, no `Float`: es dinero que se va a sumar
  // sobre decenas de citas en cada liquidación mensual, y el punto flotante
  // acumula error de redondeo en cada suma -- eso son disputas con gente que
  // cobra por su trabajo. Se decide ahora porque la columna nace vacía
  // (se agrega en esta misma migración) y esa ventana no se repite:
  // convertir un `Float` a `Decimal` con datos ya cargados es una migración
  // aparte, con `USING` y riesgo de reescritura de tabla. `Decimal(12, 2)`:
  // 2 decimales es la escala universal para dinero (centavos/céntimos), y 12
  // dígitos totales (hasta 9.999.999.999,99) da margen amplio para el monto
  // de una única cita en cualquier moneda con la que trabaje un negocio,
  // sin ser un tamaño arbitrario/desperdiciado (Postgres sólo ocupa espacio
  // por los dígitos que el valor realmente tiene, no por la precisión
  // declarada). `Appointment.price` y `Service.price` **no** se tocan acá:
  // siguen en `Float` a propósito porque ya tienen datos en producción y los
  // usa mucho código; pasarlos a `Decimal` es un cambio de otra escala y con
  // otro plan de prueba (sobre una base con datos, no vacía).
  //
  // `commissionPercent` (acá y en BusinessMember/CommissionRate) se queda en
  // `Float`, a propósito y no por descuido: un porcentaje es un valor
  // independiente por fila, no algo que se sume repetidamente como
  // `commissionAmount` en una liquidación -- no hay superficie para que un
  // error de redondeo se acumule. El error de representación de un `Float`
  // de doble precisión es del orden de 1e-15, muy por debajo de cualquier
  // precisión de porcentaje que el producto vaya a pedir (ni siquiera define
  // decimales para el porcentaje). Pasarlo a `Decimal` tampoco evitaría la
  // mezcla de tipos al calcular (`price` sigue siendo `Float`): esa conversión
  // haría falta igual en el momento del cálculo, la tenga `percent` el tipo
  // que tenga, y la tiene que resolver quien escriba ese cálculo.
  commissionPercent Float? // porcentaje ya resuelto por la cascada al momento del cálculo -- rango 0-100 vía CHECK
  commissionAmount  Decimal?  @db.Decimal(12, 2) // monto resultante, sobre el precio total sin descontar insumos
  commissionAt      DateTime? // cuándo se calculó y congeló

  // Enlace para que el cliente cancele o reagende sin cuenta. Se guarda el
  // sha256 del token (lib/tokens.ts), nunca el token en claro, como en
  // `WorkerInvitation.tokenHash`. Null = la cita no tiene enlace.
  manageTokenHash String?   @unique
  // Quién canceló: "cliente" | "negocio" (CHECK en la base) y cuándo. Null en
  // las citas no canceladas y en las canceladas antes de existir la columna.
  canceladaPor    String?
  canceladaEn     DateTime?
  // Cuándo se mandó el recordatorio. No null = ya salió y no se repite.
  reminderSentAt  DateTime?

  // La atención que nació de esta reserva, si el cliente ya llegó.
  visit Visit?

  // Etapa 5 (#89a): los servicios de la cita, en orden. Las citas de antes
  // no tienen filas y se leen por `serviceId`, como siempre.
  servicios AppointmentService[]

  // Clínica dental: evoluciones anotadas en esta cita y prestaciones del plan
  // agendadas en ella. FK compuestas y NO ACTION: borrar una cita con
  // cualquiera de las dos falla (P2003). Quien la borre primero desvincula
  // (la prestación vuelve a "por-agendar"; la evolución sólo admite poner
  // `appointmentId` en null) o responde 409.
  evoluciones         Evolucion[]
  prestacionesDelPlan PrestacionDelPlan[]

  // Habilita la FK compuesta (appointmentId, businessId) de AppointmentService.
  @@unique([id, businessId])
  @@index([businessId])
  @@index([businessId, startTime])
  // El cron de recordatorios busca por hora en todos los negocios.
  @@index([startTime])
  // Consulta de liquidación: businessId + memberId + status + rango de fechas.
  // La liquidación todavía no existe; el índice se crea junto con las columnas.
  @@index([businessId, memberId, startTime])
  @@index([customerId])
  @@index([memberId])
  @@map("citas")
}

/**
 * Un servicio de una cita con varios (#89a, etapa 5): hasta 4, del mismo
 * profesional y seguidos. Copia nombre, duración y precio al reservar: la cita
 * se lee igual aunque el catálogo cambie o el servicio se borre. Las citas de
 * antes no tienen filas acá; ahí manda `Appointment.serviceId`.
 * La cita es FK compuesta (appointmentId, businessId): Postgres rechaza una
 * fila que mezcle la cita de otro negocio, y se borra con ella. El servicio es
 * FK simple con SetNull, como en `VisitService`: SetNull en una compuesta
 * anularía también `businessId`. Que el servicio sea del negocio lo garantiza
 * quien escribe (sólo se copian servicios leídos con el `businessId` de la
 * reserva). CHECKs en la migración: orden 1..4, duración > 0, precio ≥ 0.
 */
model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// Copias del catálogo al reservar.
  serviceName   String
  duration      Int // minutos
  price         Float? // ya con la rebaja de hora valle, si la hubo
  /// 1..4, en el orden en que se hacen.
  orden         Int
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, orden])
  @@index([businessId])
  @@index([serviceId])
  @@map("cita_servicios")
}

/**
 * Una franja de hora valle (#89c): un % de rebaja para las reservas públicas
 * que EMPIEZAN dentro de [desde, hasta) ese día de la semana, en la zona del
 * negocio. Sólo rige con `Business.horaValleActiva`. CHECKs en la migración:
 * dayOfWeek 0..6, "HH:MM" válidos, desde < hasta, porcentaje 5..90.
 */
model FranjaDeHoraValle {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = domingo … 6 = sábado, como WorkSchedule
  desde      String // "HH:MM"
  hasta      String // "HH:MM"
  porcentaje Int // 5..90
  createdAt  DateTime @default(now())

  @@index([businessId, dayOfWeek])
  @@map("franjas_de_hora_valle")
}

// ─── Tablero de atenciones (docs/PRODUCTO.md, sección 7) ────────────────────
//
// La cita es lo planeado; la atención es lo que de verdad se hizo y se cobró.
// Es historial de dinero: por eso copia los nombres (cliente, servicio,
// profesional) en vez de depender de que esos registros sigan existiendo, y
// sus relaciones con el resto del negocio son opcionales y quedan en null si
// el otro lado se borra. Lo único que arrastra a una atención es borrar el
// negocio entero.
model Visit {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String // copia: el historial se lee igual aunque el cliente se borre
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  // En la base, además, una CHECK lo limita a los cinco de `lib/atenciones.ts`.
  status        String       @default("en-espera") // en-espera, en-atencion, por-cobrar, finalizada, anulada
  notes         String?
  arrivedAt     DateTime     @default(now())
  startedAt     DateTime?
  readyAt       DateTime?
  paidAt        DateTime?
  voidedAt      DateTime?
  voidReason    String?
  // En centavos enteros, como todo el dinero de estas tres tablas: un `Float`
  // guarda 0,1 + 0,2 como 0,30000000000000004, y el cobro se compara al
  // centavo. La API sigue hablando en unidades; se convierte en el borde
  // (`aCentavos`/`deCentavos`). Los topes que impiden desbordar el `Int` están
  // en `lib/atenciones.ts`.
  //
  // Se congela al cobrar y no se recalcula nunca más. Mientras la atención
  // está abierta queda en null: el total vivo es la suma de las líneas.
  //
  // Prisma no representa restricciones CHECK en este archivo: las del dinero
  // (total, precios y pagos) y la del estado están escritas a mano al final de
  // la migración del tablero. Son la segunda barrera, porque no hay RLS.
  totalCents    Int?
  // Ids de `User` SIN relación, a propósito. Con una FK, borrar al usuario
  // obligaría a poner estas columnas en null (o a impedir el borrado) y se
  // perdería quién cobró o anuló algo ya cobrado: justo el dato que hace falta
  // para resolver una discusión sobre dinero. Por eso nadie puede navegar de
  // acá al usuario con Prisma: el id se guarda como registro, no como vínculo.
  createdById   String?
  paidById      String?
  voidedById    String?
  // Copia del nombre de quien cobró y de quien anuló, como `professionalName`
  // en las líneas: el id solo se resuelve mientras la persona siga en el
  // negocio, y si se va, el historial tiene que seguir diciendo quién fue.
  paidByName    String?
  voidedByName  String?

  // ─── Fila virtual (etapa 4, #85) ────────────────────────────────────────
  // Quien se anota desde `/fila/[slug]` es una atención "en-espera" más, con
  // `origen` "fila": así el Tablero la atiende igual que a quien llega sin
  // reserva. El nombre va en `customerName` (no hay cliente). Una CHECK
  // limita `origen` a "tablero" | "fila" y obliga a que las columnas fila*
  // estén todas en null fuera de la fila, y token, fecha y número dentro.
  origen        String    @default("tablero")
  /// Hash del token del enlace del celular (nunca el token en claro).
  filaTokenHash String?   @unique
  /// Correo opcional para el aviso "queda 1 persona adelante".
  filaEmail     String?
  /// Día del negocio, en su zona, "YYYY-MM-DD": el número de turno se cuenta por día.
  filaFecha     String?
  /// Número de turno del día en el negocio (1, 2, 3…). Único por (negocio, día).
  filaNumero    Int?
  /// Cuándo se mandó el aviso "queda 1 persona adelante". No null = ya avisada.
  filaAvisadaAt DateTime?

  services                 VisitService[]
  payments                 VisitPayment[]
  propinas                 PropinaDeAtencion[]
  movimientosDeLiquidacion MovimientoDeLiquidacion[]

  // Habilita las FK compuestas (visitId, businessId) de las propinas y de los
  // movimientos de liquidación, como en BusinessMember.
  @@unique([id, businessId])
  // Numerar sin repetir y listar la fila del día de un negocio. En Postgres
  // las filas con null no chocan, así que las atenciones del Tablero no cuentan.
  @@unique([businessId, filaFecha, filaNumero])
  @@index([businessId, status])
  @@index([businessId, paidAt])
  @@index([customerId])
  @@map("atenciones")
}

// Una línea de la atención: qué servicio se hizo, quién lo hizo y a qué precio.
// Es la base de las comisiones (sección 3).
model VisitService {
  id               String          @id @default(cuid())
  visitId          String
  visit            Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName      String // copia del nombre del catálogo al anotarla
  memberId         String?
  member           BusinessMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  // El dueño no es `BusinessMember`, así que su línea se marca acá y lleva
  // `memberId` en null. Nunca se usa un `memberId` nulo para decir "dueño": al
  // borrar a un miembro, su `memberId` queda en null, y esa línea pasaría a
  // leerse como del dueño. Con la marca aparte, una línea sin `memberId` y sin
  // `byOwner` es de alguien que ya no está en el equipo, y se lee como tal.
  byOwner          Boolean         @default(false)
  professionalName String // copia del nombre de quien la hizo
  priceCents       Int // centavos enteros, como `Visit.totalCents`

  /// "servicio" | "producto" (CHECK). Una línea de producto lleva `productId`
  /// y no `serviceId`; una de servicio, al revés (CHECK). `serviceName` guarda
  /// el nombre copiado en los dos casos. Un producto vendido dos veces son dos
  /// líneas: no hay cantidad.
  tipo      String    @default("servicio")
  productId String?
  product   Producto? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Comisión congelada por línea al cobrar (#65). Reemplaza a las columnas
  // de `citas`, que quedan sin uso. Los tres en null = pendiente (sin % al
  // cobrar), nunca 0; los tres juntos o ninguno (CHECK). Las líneas `byOwner`
  // nunca llevan comisión (CHECK). Una vez congelada no cambia: lo impide el
  // trigger `atencion_servicios_comision_inmutable` de la migración.
  commissionPercent Float? // 0-100 vía CHECK
  commissionCents   Int? // 0..priceCents vía CHECK
  commissionAt      DateTime?

  /// La liquidación que ya pagó esta línea. Con valor, el trigger impide
  /// cambiarle precio, profesional o comisión. FK simple: la línea no tiene
  /// `businessId` propio (va por la atención).
  liquidacionId String?
  liquidacion   Liquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: NoAction)

  // ─── Abono de una prótesis (etapa 7; lo usa la tanda del cobro) ─────────
  // Una línea con `protesisId` es un abono a esa prótesis: `serviceName` lo
  // describe, `priceCents` es lo abonado y no lleva servicio, producto ni la
  // comisión de la cascada (CHECK `atencion_servicios_protesis_check`: la
  // parte de la odontóloga no se paga dos veces). Al cobrar se congela el
  // reparto del abono en tres partes con la regla congelada de la prótesis
  // (`lib/protesis.ts`, `repartirMonto`): los tres juntos o ninguno, suman
  // `priceCents`, y la dueña no lleva parte de odontóloga (CHECKs). Una vez
  // congelado no cambia (trigger `atencion_servicios_reparto_de_protesis`).
  // La parte de la odontóloga se libera para la liquidación cuando la prótesis
  // está entregada (`Protesis.entregadaEn`); la del técnico pasa a "por pagar
  // al laboratorio" con la misma regla, y `pagoAlLaboratorioId` dice en qué
  // pago se le pagó. FK simples (la línea no tiene `businessId`): el mismo
  // trigger exige que la prótesis y el pago sean del negocio de la atención.
  protesisId          String?
  protesis            Protesis?          @relation(fields: [protesisId], references: [id], onDelete: NoAction)
  odontologoCents     Int?
  clinicaCents        Int?
  tecnicoCents        Int?
  pagoAlLaboratorioId String?
  pagoAlLaboratorio   PagoAlLaboratorio? @relation(fields: [pagoAlLaboratorioId], references: [id], onDelete: NoAction)

  @@index([visitId])
  @@index([memberId])
  @@index([productId])
  @@index([memberId, liquidacionId])
  @@index([protesisId])
  @@index([pagoAlLaboratorioId])
  @@map("atencion_servicios")
}

// Un pago de la atención. Un cobro se puede repartir entre varios medios
// (`lib/medios-de-pago.ts`); la suma coincide con el total al centavo.
model VisitPayment {
  id          String   @id @default(cuid())
  visitId     String
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  method      String // id de `lib/medios-de-pago.ts`: efectivo, tarjeta-debito, ... (CHECK en la base)
  amountCents Int // centavos enteros, como `Visit.totalCents`
  createdAt   DateTime @default(now())

  @@index([visitId])
  @@map("atencion_pagos")
}

/**
 * Un producto que vende el negocio (shampoo, cera). Sin inventario: sólo el
 * nombre, el precio sugerido y el % de comisión de quien lo vende. El catálogo
 * lo gestionan dueña y encargado; el % sólo la dueña (`lib/permisos.ts`).
 * `commissionPercent` null es "sin configurar", no 0, como en BusinessMember.
 */
model Producto {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  priceCents        Int? // centavos; 0..2e9 vía CHECK
  commissionPercent Float? // 0-100 vía CHECK; null = pendiente
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  visitServices     VisitService[]
  commissionChanges CommissionChange[]

  @@unique([id, businessId])
  @@index([businessId])
  @@map("productos")
}

/**
 * Una propina de una atención (#66). Tabla propia y no `VisitPayment`: la
 * propina no es ingreso del negocio, así que no puede sumar en el tablero ni
 * en los reportes. Va 100 % al profesional y se paga en la liquidación; la de
 * la dueña (`byOwner`) no entra a ninguna (CHECK).
 * FK compuestas contra (id, businessId), como CommissionRate: Postgres rechaza
 * una propina que mezcle la atención o el miembro de otro negocio. Los
 * miembros con NO ACTION y no SetNull: SetNull en una compuesta anularía
 * también `businessId`.
 */
model PropinaDeAtencion {
  id               String          @id @default(cuid())
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visitId          String
  visit            Visit           @relation(fields: [visitId, businessId], references: [id, businessId], onDelete: Cascade)
  memberId         String?
  member           BusinessMember? @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: NoAction)
  /// Como en `VisitService`: la dueña no es miembro. O `byOwner` o `memberId`, nunca los dos ni ninguno (CHECK).
  byOwner          Boolean         @default(false)
  professionalName String // copia del nombre
  method           String // id de `lib/medios-de-pago.ts`
  amountCents      Int // > 0 y ≤ 2e9 vía CHECK
  liquidacionId    String?
  liquidacion      Liquidacion?    @relation(fields: [liquidacionId, businessId], references: [id, businessId], onDelete: NoAction)
  createdAt        DateTime        @default(now())

  @@index([visitId])
  @@index([businessId, memberId, liquidacionId])
  @@map("atencion_propinas")
}

/**
 * Lo que se le paga a un profesional por un período (#68), congelado al
 * cerrar: los montos son un snapshot y no se recalculan. Las líneas, propinas
 * y movimientos incluidos quedan marcados con su `liquidacionId`. Anularla
 * (sólo cerrada, no pagada) los libera.
 * `desde` y `hasta` son días del negocio (incluidos los dos), en su `zona`.
 * Una sola liquidación no anulada por (negocio, miembro, desde): índice único
 * parcial escrito a mano en la migración. Los ids de `User` (cerradaPorId…)
 * van sin FK, como `Visit.paidById`, con el nombre copiado al lado.
 */
model Liquidacion {
  id                     String         @id @default(cuid())
  businessId             String
  business               Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId               String
  member                 BusinessMember @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: NoAction)
  memberName             String
  /// "semanal" | "quincenal" | "mensual" (CHECK), el vigente al cerrar.
  periodo                String
  desde                  DateTime       @db.Date
  hasta                  DateTime       @db.Date
  zona                   String
  /// "cerrada" | "pagada" | "anulada" (CHECK).
  estado                 String         @default("cerrada")
  comisionServiciosCents Int
  comisionProductosCents Int
  /// La parte de la odontóloga de los abonos de prótesis entregadas (etapa 7b). 0 si no hubo.
  comisionProtesisCents  Int            @default(0)
  propinasCents          Int
  adelantosCents         Int // adelantos y vales: descuentan
  ajustesCents           Int // con signo
  brutoCents             Int // comisiones (servicios, productos y prótesis) + propinas
  totalCents             Int // bruto − adelantos ± ajustes; ≥ 0 (CHECK): no se cierra en negativo
  cerradaAt              DateTime       @default(now())
  cerradaPorId           String
  cerradaPorNombre       String
  pagadaAt               DateTime?
  pagadaPorId            String?
  pagadaPorNombre        String?
  medioDePago            String?
  anuladaAt              DateTime?
  anuladaPorId           String?
  anuladaPorNombre       String?
  motivoAnulacion        String?
  nota                   String?

  lineas      VisitService[]
  propinas    PropinaDeAtencion[]
  movimientos MovimientoDeLiquidacion[]

  @@unique([id, businessId])
  @@index([businessId, memberId, desde])
  @@map("liquidaciones")
}

/**
 * Adelantos y vales (descuentan) y ajustes (con signo, con motivo) de un
 * profesional, que entran en su próxima liquidación. Adelantos y vales los
 * registran dueña y encargado; ajustes, sólo la dueña. No se borran: se
 * anulan, y uno anulado no puede estar en una liquidación (CHECK).
 */
model MovimientoDeLiquidacion {
  id               String         @id @default(cuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId         String
  member           BusinessMember @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: NoAction)
  memberName       String
  /// "adelanto" | "vale" | "ajuste" (CHECK).
  tipo             String
  /// Adelanto y vale: > 0. Ajuste: ≠ 0, con signo. Tope 2e9 (CHECK).
  montoCents       Int
  fecha            DateTime       @db.Date
  /// Obligatorio para un ajuste (lo exige la app).
  motivo           String?
  /// La atención que corrige un ajuste, si corrige una.
  visitId          String?
  visit            Visit?         @relation(fields: [visitId, businessId], references: [id, businessId], onDelete: NoAction)
  liquidacionId    String?
  liquidacion      Liquidacion?   @relation(fields: [liquidacionId, businessId], references: [id, businessId], onDelete: NoAction)
  anuladoAt        DateTime?
  anuladoPorId     String?
  anuladoPorNombre String?
  createdById      String
  createdByName    String
  createdAt        DateTime       @default(now())

  @@index([businessId, memberId, liquidacionId])
  @@map("movimientos_de_liquidacion")
}

/**
 * Un cierre de caja (#71). Cubre (desde, hasta]: desde es el `hasta` del
 * cierre anterior (o el inicio del día del negocio) y hasta, el momento del
 * cierre. Varios por día. Los montos son un snapshot; un cierre no se edita.
 * Las CHECK de la migración garantizan esperado = fondo + cobrado + propinas
 * y diferencia = contado − esperado. `desglose`: otros medios, informativo.
 */
model CierreDeCaja {
  id                    String   @id @default(cuid())
  businessId            String
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  desde                 DateTime
  hasta                 DateTime
  /// El día del negocio del cierre, en su `zona`.
  fecha                 DateTime @db.Date
  zona                  String
  fondoInicialCents     Int
  efectivoCobradoCents  Int
  propinasEfectivoCents Int
  efectivoEsperadoCents Int
  efectivoContadoCents  Int
  diferenciaCents       Int
  desglose              Json     @default("{}")
  /// Obligatoria si la diferencia no es 0 (lo exige la app).
  nota                  String?
  cerradoPorId          String
  cerradoPorNombre      String
  createdAt             DateTime @default(now())

  @@unique([businessId, hasta])
  @@index([businessId, desde])
  @@map("cierres_de_caja")
}

/**
 * Excepción de comisión para un profesional en un servicio puntual. Primer
 * escalón de la cascada (regla 1 de docs/PRODUCTO.md §3.1): si existe una fila
 * para (memberId, serviceId), gana sobre `BusinessMember.commissionPercent`.
 * Modelo "con herencia": no hace falta una fila por cada combinación
 * profesional × servicio, sólo donde hay una excepción real.
 * `member` y `service` usan FK compuesta contra `(id, businessId)` del
 * profesional y del servicio, no contra `id` solo. Sin esto, Postgres acepta
 * una fila con el `businessId` de un negocio y el `memberId`/`serviceId` de
 * otro (nada las relaciona entre sí), y es exactamente el caso que
 * `findUnique(memberId_serviceId)` -- la resolución de la cascada -- no puede
 * filtrar por negocio: aplicaría el porcentaje de otro negocio a una cita, y
 * quedaría congelado. La FK compuesta hace que Postgres rechace el insert
 * directamente.
 */
model CommissionRate {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId   String
  member     BusinessMember @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: Cascade)
  serviceId  String
  // Restrict, no Cascade: borrar un servicio con comisiones configuradas debe
  // fallar, no arrastrarlas en silencio. `puedeGestionarServicios` incluye al
  // encargado, pero `puedeEditarComisiones` es sólo del dueño -- con Cascade,
  // el encargado borra un servicio y de paso borra los porcentajes de
  // comisión de todos los profesionales para ese servicio, sin pasar nunca
  // por un permiso de comisiones. Restrict cierra ese atajo en la base, no
  // sólo en la app. Es un cambio real de comportamiento, no la formalización
  // de algo que ya pasaba: `Appointment.service` es `ON DELETE SET NULL`
  // (migración init, línea 161), o sea que hoy borrar un servicio con
  // historial funciona. A partir de acá, borrar uno con comisiones
  // configuradas falla; quien quiera hacerlo primero quita esas filas de
  // `CommissionRate`, o lo desactiva con `Service.active` sin borrarlo (el
  // endpoint devuelve 409 con esa explicación).
  service    Service        @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict)
  percent    Float // 0-100 -- rango vía CHECK de la migración, no Prisma. Nunca tiene default: la fila sólo existe si alguien la configuró.
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Sin esto, dos porcentajes para la misma combinación hacen la cascada no
  // determinista. También es la clave que usa la resolución en cascada
  // (findUnique por memberId_serviceId), así que de paso queda indexada.
  @@unique([memberId, serviceId])
  @@index([businessId])
  @@map("porcentajes_comision")
}

/**
 * Qué servicios hace cada profesional. Un profesional SIN filas acá hace todos
 * los servicios del negocio (así funcionaba antes, y así siguen los que ya
 * existen); con al menos una fila, hace sólo esos.
 * `member` y `service` usan FK compuesta contra `(id, businessId)`, como en
 * `CommissionRate`: Postgres rechaza una fila que mezcle el profesional o el
 * servicio de un negocio con el `businessId` de otro. Cascade en las tres: la
 * fila no tiene sentido sin el profesional o sin el servicio.
 */
model MemberService {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId   String
  member     BusinessMember @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: Cascade)
  serviceId  String
  service    Service        @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([memberId, serviceId])
  @@index([businessId])
  @@map("member_services")
}

/**
 * Un bloqueo de horario: un rango en que no se puede agendar. Con `memberId`
 * bloquea sólo a ese profesional (vacaciones, trámite); con `memberId` null
 * bloquea todo el negocio (feriado, cierre). Que `endTime` sea mayor que
 * `startTime` lo garantiza un CHECK de la migración, no Prisma.
 * `member` usa FK compuesta contra `(id, businessId)`, como `CommissionRate`;
 * con `memberId` null Postgres no la revisa (MATCH SIMPLE), que es justo el
 * bloqueo de todo el negocio.
 */
model TimeBlock {
  id          String          @id @default(cuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId    String?
  member      BusinessMember? @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  motivo      String?
  // Id de `User` SIN relación, como `Visit.createdById`: el registro de quién
  // lo creó no debe depender de que el usuario siga existiendo.
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([businessId, startTime])
  @@index([memberId, startTime])
  @@map("time_blocks")
}

/**
 * Auditoría de cambios de porcentaje (docs/PRODUCTO.md §3.5): quién, cuándo, de
 * qué valor a qué valor. `scope` dice a qué aplicó el cambio ("default" = al
 * porcentaje por defecto del profesional, "service" = a una excepción
 * puntual) y es explícito: no se infiere de si `serviceId` es null, porque
 * `serviceId` puede volverse null por SetNull al borrarse el servicio, y ese
 * mismo valor es el que usa la cascada para decir "sin excepción". Si el
 * significado dependiera de `serviceId`, borrar un servicio reescribiría en
 * silencio "cambié la excepción de Juan en Color" por "cambié el porcentaje
 * por defecto de Juan" -- la auditoría no quedaría incompleta, quedaría
 * mintiendo, y no habría forma de distinguir un registro adulterado de uno
 * legítimo. `serviceName` es un snapshot del nombre del servicio al momento
 * del cambio, para que el registro siga siendo legible si el servicio se
 * borra (sólo tiene sentido cuando `scope = "service"`).
 * `memberId` y `changedById` son nullable con SetNull, y `memberName` /
 * `changedByName` / `changedByEmail` son snapshots tomados al crear la fila.
 * Una tabla de auditoría no puede cascadear con lo que audita: si
 * `changedById` cascadeara, borrar al usuario borraría el registro de los
 * cambios que hizo; si `memberId` cascadeara, dar de baja a un profesional
 * borraría todo su historial de comisiones justo cuando más se necesita (una
 * baja es cuando aparecen las disputas). SetNull + snapshot hace que la fila
 * sobreviva siempre, legible, aunque lo auditado desaparezca.
 * Ninguna de las dos relaciones usa la FK compuesta de `CommissionRate`
 * (`(id, businessId)`): una FK compuesta con `onDelete: SetNull` anula TODAS
 * las columnas de la constraint a la vez, incluida `businessId` -- y
 * `businessId` acá es NOT NULL (aislamiento entre negocios: toda fila debe poder
 * filtrarse por negocio), así que esa combinación o rompe el insert o vuelve
 * la fila invisible para cualquier consulta multi-tenant. Quedan como FK
 * simples contra `.id`; el negocio se resuelve siempre escribiendo el
 * `businessId` del actor de sesión al crear la fila, igual que en el resto
 * del código (nunca del cliente). `changedById` tampoco admite FK compuesta
 * por otra razón: `usuarios` no tiene `businessId` (el dueño no es miembro del
 * negocio). Sólo el dueño puede generar estas filas (`lib/permisos.ts`,
 * `puedeEditarComisiones`), por eso quien cambia es un `User` y no un
 * `BusinessMember`.
 */
model CommissionChange {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  memberId   String?
  member     BusinessMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberName String // snapshot del nombre del profesional al momento del cambio

  scope       String // "default" | "service" | "product" -- explícito, no inferido de serviceId (ver comentario del modelo)
  serviceId   String?
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String? // snapshot; sólo aplica cuando scope = "service"
  // Como serviceId/serviceName, para el % de un producto (scope = "product").
  productId   String?
  product     Producto? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String? // snapshot; sólo aplica cuando scope = "product"

  changedById    String?
  changedBy      User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedByName  String // snapshot
  changedByEmail String // snapshot

  // `null` en cualquiera de los dos es "no estaba configurado" (no es lo mismo
  // que 0), igual que en los campos que audita. Rango 0-100 vía CHECK.
  previousPercent Float?
  newPercent      Float?

  createdAt DateTime @default(now())

  // Multi-tenant: todo índice empieza por businessId. Sirve tanto para
  // "auditoría del negocio" como, con el prefijo, para "auditoría de este
  // profesional en este negocio".
  @@index([businessId, memberId, createdAt])
  @@map("cambios_comision")
}

model Conversation {
  id            String   @id @default(cuid())
  // Mismo caso que `Appointment.customerId`: las columnas conservan su nombre.
  customerName  String   @map("patientName")
  customerPhone String?  @map("patientPhone")
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@index([businessId])
  @@map("conversaciones")
}

model Message {
  id             String       @id @default(cuid())
  content        String
  fromBusiness   Boolean
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("mensajes")
}

/// Una solicitud de soporte (falla, reclamo o consulta) hecha desde
/// /dashboard/ayuda o desde la página pública /soporte. Se guarda antes de
/// mandar los correos: si el envío falla, el caso queda igual. Los valores
/// válidos de `tipo` y `area` están en `lib/soporte.ts`.
model SolicitudDeSoporte {
  id           String    @id @default(cuid())
  /// Número de caso que ve la persona ("#000123", `formatearNumeroDeCaso`).
  numero       Int       @unique @default(autoincrement())
  tipo         String
  area         String
  asunto       String
  descripcion  String
  /// Texto libre: en qué pantalla o URL pasó.
  dondeOcurrio String?
  /// Con sesión salen de la cuenta, no del formulario; sin sesión los escribe
  /// la persona.
  nombre       String
  email        String
  /// Con sesión, el negocio de la sesión (nunca uno que mande el cliente). Si
  /// se borra el negocio o el usuario, la solicitud queda sin el vínculo.
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  estado       String    @default("recibida")
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([businessId])
  @@index([userId])
  @@map("solicitudes_de_soporte")
}

/// "Avísame si se libera una hora" (#74): alguien que quería reservar un día
/// sin horas libres. Se guarda por email, no por cliente: quien se inscribe
/// puede no ser cliente todavía. El servicio es FK compuesta (id, businessId):
/// la base impide una inscripción con el servicio de otro negocio. El
/// profesional es FK simple y SetNull (null = "cualquiera"): que sea del mismo
/// negocio lo verifica el código.
///
/// `estado`: "activa" | "reservo" | "expirada" | "salio" (CHECK). `fecha` es un
/// día "AAAA-MM-DD" en la zona del negocio (CHECK de forma). `tokenHash` es el
/// sha256 del token de "Salir de la lista" (`lib/tokens.ts`). El cron expira
/// las de días pasados y borra sus datos personales.
model InscripcionEnEspera {
  id                String          @id @default(cuid())
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId         String
  service           Service         @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)
  memberId          String?
  member            BusinessMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fecha             String
  nombre            String
  apellido          String
  /// Normalizado (minúsculas, sin espacios a los lados).
  email             String
  telefono          String?
  whatsappConsentAt DateTime?
  estado            String          @default("activa")
  /// Cuántos avisos se le mandaron (tope en `lib/envios-a-clientes.ts`).
  avisos            Int             @default(0)
  ultimoAvisoAt     DateTime?
  tokenHash         String          @unique
  createdAt         DateTime        @default(now())
  /// Cuándo dejó de estar activa (reservó, expiró o salió).
  resueltaAt        DateTime?

  envios EnvioAClientes[]

  @@index([businessId, fecha, estado])
  @@index([businessId, email])
  @@map("lista_de_espera")
}

/// Cada mensaje a un cliente (#78): registro, candado y contador a la vez.
/// El único (businessId, tipo, referencia) es el candado: la fila se inserta
/// ANTES de enviar, y si ya existía, otro proceso lo mandó o lo está mandando
/// (`lib/envios-a-clientes.ts`). Si el envío falla, la fila se borra.
///
/// Sin datos personales: ni el email ni el texto. `customerId` y `esperaId`
/// son FK simples y SetNull (borrar el cliente o la inscripción no borra la
/// cuenta del mes); que sean del mismo negocio lo verifica el código.
/// `tipo`, `canal` y `categoria` los limitan CHECKs de la migración.
model EnvioAClientes {
  id         String               @id @default(cuid())
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  esperaId   String?
  espera     InscripcionEnEspera? @relation(fields: [esperaId], references: [id], onDelete: SetNull)
  /// "lista-de-espera" | "te-toca" | "resena" | "contacto-manual"
  tipo       String
  /// "correo" | "whatsapp" | "manual"
  canal      String
  /// "servicio" | "promocional"
  categoria  String
  /// Qué cosa se avisó, para no repetirla (ver `lib/envios-a-clientes.ts`).
  referencia String
  enviadoAt  DateTime             @default(now())

  @@unique([businessId, tipo, referencia])
  @@index([businessId, enviadoAt])
  @@index([customerId, tipo, enviadoAt])
  @@index([esperaId])
  @@map("envios_a_clientes")
}

// ─── Clínica dental (rubro "odontologia") ───────────────────────────────────
//
// Sillones, ficha clínica, odontograma, evoluciones y plan de tratamiento.
// Las tablas existen para todo negocio, pero sólo uno dental las ve y las
// escribe: lo decide `lib/permisos.ts` (`esClinicaDental` y sus `whereDe*`),
// que falla cerrado. Todas las FK a otra fila del negocio son compuestas
// contra `(id, businessId)`: Postgres rechaza una fila que mezcle el paciente,
// la cita, el servicio o el odontólogo de otro negocio. Las que apuntan a
// citas, servicios y miembros son NO ACTION (no SetNull: en una compuesta
// anularía también `businessId`; no Restrict: rompería el borrado en cascada
// del negocio entero), así que borrar una de esas filas mientras algo dental
// la referencia falla con P2003. Los CHECKs, los únicos parciales y el
// trigger de las evoluciones están escritos a mano en la migración
// `20261106120000_etapa_6_odontologia`.
//
// Con FK compuestas que comparten `businessId`, se escribe con los ids
// (`sillonId`, `memberId`, `serviceId`...) y no con `connect`/`disconnect`:
// desconectar una relación compuesta intentaría anular también `businessId`.

/**
 * Un sillón de la clínica. La cita lleva uno opcional (`Appointment.sillonId`)
 * y la agenda se puede ver en columnas por sillón, en `orden`. No se borra: se
 * desactiva con `activo` (las citas viejas lo siguen nombrando). Nombre único
 * por negocio. CHECKs: nombre no vacío, orden 0..999.
 */
model Sillon {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre     String
  orden      Int      @default(0)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  citas Appointment[]

  // Habilita la FK compuesta (sillonId, businessId) de las citas.
  @@unique([id, businessId])
  @@unique([businessId, nombre])
  @@map("sillones")
}

/**
 * Los antecedentes del paciente: una fila por cliente (1:1, FK compuesta).
 * Se crea con la primera escritura (antecedentes u odontograma), así que un
 * paciente sin ficha es un paciente sin nada anotado.
 * `updatedAt`/`actualizadaPor`: el último cambio de cualquier parte de la
 * ficha. `odontogramaActualizadoEn`/`Por`: el último cambio del odontograma
 * ("Actualizado el 28 oct por Dra. Soto"); los dos juntos o ninguno (CHECK).
 * Los nombres van copiados, como `Liquidacion.cerradaPorNombre`.
 * `alergias` la ve también el encargado, como alerta en el panel de la cita
 * (`whereDeAlertaDeAlergias`, con un `select` sólo de esa columna); el resto,
 * sólo dueño y odontólogos (`whereDeFichasClinicas`).
 */
model FichaClinica {
  id                        String    @id @default(cuid())
  businessId                String
  business                  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId                String
  customer                  Customer  @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Cascade)
  /// Para la edad. CHECK: desde 1900-01-01.
  fechaNacimiento           DateTime? @db.Date
  /// "fonasa" | "isapre" | "particular" | "otra" (CHECK). Null = sin anotar.
  prevision                 String?
  /// Null = sin anotar. Lo que se escriba acá sale como alerta en la cita.
  alergias                  String?
  /// Enfermedades, medicamentos y otros antecedentes, en texto.
  antecedentes              String?
  odontogramaActualizadoEn  DateTime?
  odontogramaActualizadoPor String?
  actualizadaPor            String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([customerId, businessId])
  @@map("fichas_clinicas")
}

/**
 * Una marca del odontograma (notación FDI, `lib/odontograma.ts`). De cara
 * (`cara` no null): caries, obturación o sellante en V, P, L, M, D, O o I. De
 * pieza (`cara` null): corona, endodoncia, ausente o extracción indicada.
 * Los CHECKs repiten las reglas de `errorDeMarca`: pieza FDI válida, el tipo
 * con o sin cara según corresponda, P sólo en el maxilar, L sólo en la
 * mandíbula, I sólo en incisivos y caninos, O sólo en premolares y molares.
 * Una sola marca por cara (este único) y un solo tipo de pieza repetido por
 * pieza (único parcial escrito a mano). Sin historial: quién y cuándo, en la
 * ficha (`odontogramaActualizadoEn`/`Por`).
 */
model MarcaDental {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Cascade)
  /// 11-18, 21-28, 31-38, 41-48 (permanente); 51-55, 61-65, 71-75, 81-85 (temporal).
  pieza      Int
  /// "V" | "P" | "L" | "M" | "D" | "O" | "I"; null = marca de la pieza entera.
  cara       String?
  /// caries | obturacion | sellante (de cara); corona | endodoncia | ausente | extraccion (de pieza).
  tipo       String
  createdAt  DateTime @default(now())

  // En Postgres las filas con `cara` null no chocan entre sí: equivale al
  // único parcial "una marca por cara" y deja hacer `upsert` por cara.
  @@unique([customerId, pieza, cara])
  @@index([businessId, customerId])
  @@map("odontograma_marcas")
}

/**
 * Una evolución: lo que se hizo y se observó en una atención, con fecha y
 * autor. Sólo se agregan: el trigger `evoluciones_inmutables` rechaza todo
 * UPDATE salvo desvincular la cita o el miembro (ponerlos en null, para poder
 * borrar la cita o al miembro). El borrado en cascada desde el cliente o el
 * negocio sigue como en el resto de las tablas.
 * `autorNombre` es copia (el historial se lee igual si la persona se va);
 * `autorUserId` es el id de `User` sin FK, como `Visit.createdById`, y vale
 * también para el dueño, que no es miembro. `memberId` y `appointmentId` son
 * FK compuestas NO ACTION.
 */
model Evolucion {
  id            String          @id @default(cuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer        @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Cascade)
  texto         String
  autorNombre   String
  autorUserId   String?
  memberId      String?
  member        BusinessMember? @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: NoAction)
  appointmentId String?
  appointment   Appointment?    @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: NoAction)
  createdAt     DateTime        @default(now())

  @@index([businessId, customerId, createdAt])
  @@index([appointmentId])
  @@map("evoluciones")
}

/**
 * Un plan de tratamiento del paciente, con versiones: rehacerlo crea una
 * versión nueva (`version` + 1) y la anterior deja de estar `vigente`. Un solo
 * plan vigente por paciente (único parcial escrito a mano) y versiones sin
 * repetir (este único). Totales y propuesta desde el odontograma:
 * `lib/plan-de-tratamiento.ts`. Sin pagos ni abonos: el plan no es dinero
 * cobrado, es un presupuesto.
 */
model PlanDeTratamiento {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Cascade)
  /// 1, 2, 3… por paciente (CHECK ≥ 1).
  version         Int
  vigente         Boolean  @default(true)
  creadoPorNombre String
  createdAt       DateTime @default(now())

  etapas EtapaDelPlan[]

  // Habilita la FK compuesta (planId, businessId) de las etapas.
  @@unique([id, businessId])
  @@unique([customerId, version])
  @@index([businessId, customerId])
  @@map("planes_de_tratamiento")
}

/**
 * Una etapa del plan ("Higiene y urgencia"), en `orden`. "por-aprobar" o
 * "aprobada" (CHECK); aprobada lleva cuándo y quién, y sólo ella (CHECK).
 * `presentadaEn`: cuándo se le presentó al paciente. Sólo lo registra: Eli no
 * manda el presupuesto por ningún canal. Las presentadas y por aprobar son
 * los "presupuestos por responder" del inicio.
 */
model EtapaDelPlan {
  id                String            @id @default(cuid())
  businessId        String
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId            String
  plan              PlanDeTratamiento @relation(fields: [planId, businessId], references: [id, businessId], onDelete: Cascade)
  /// 1, 2, 3… dentro del plan (CHECK ≥ 1). Sin único: reordenar no choca.
  orden             Int
  nombre            String
  estado            String            @default("por-aprobar")
  presentadaEn      DateTime?
  aprobadaEn        DateTime?
  aprobadaPorNombre String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  prestaciones PrestacionDelPlan[]

  // Habilita la FK compuesta (etapaId, businessId) de las prestaciones.
  @@unique([id, businessId])
  @@index([planId, orden])
  @@index([businessId, estado])
  @@map("etapas_del_plan")
}

/**
 * Una prestación de una etapa: pieza (null = "Boca"), caras, qué se hace,
 * quién y cuánto. `nombre` es copia (del servicio sugerido o escrita), como
 * `AppointmentService.serviceName`; `serviceId` sólo dice de dónde salió.
 * `profesionalNombre` es copia; `memberId` null con nombre es el dueño.
 * `valorCents`: centavos enteros con tope 2.000.000.000, como el dinero del
 * tablero y de la liquidación (`lib/atenciones.ts`, `aCentavos`): los totales
 * del plan se suman, y en `Float` la suma arrastra error.
 * Estado (CHECKs): "por-agendar" sin cita, "agendada" con cita, "realizada"
 * con `realizadaEn` (con o sin cita). Las caras, como en el odontograma, sólo
 * con pieza y válidas para ella. Cita, servicio y miembro son FK compuestas
 * NO ACTION.
 */
model PrestacionDelPlan {
  id                String          @id @default(cuid())
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  etapaId           String
  etapa             EtapaDelPlan    @relation(fields: [etapaId, businessId], references: [id, businessId], onDelete: Cascade)
  /// 1, 2, 3… dentro de la etapa (CHECK ≥ 1).
  orden             Int
  /// Pieza FDI, como en `MarcaDental`; null = toda la boca.
  pieza             Int?
  caras             String[]        @default([])
  serviceId         String?
  service           Service?        @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: NoAction)
  nombre            String
  memberId          String?
  member            BusinessMember? @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: NoAction)
  profesionalNombre String?
  estado            String          @default("por-agendar")
  valorCents        Int
  appointmentId     String?
  appointment       Appointment?    @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: NoAction)
  realizadaEn       DateTime?
  /// La prótesis que se agregó al plan con esta prestación ("Agregar al plan
  /// y presupuesto"; nace de "Boca" y se edita como cualquier otra). FK
  /// compuesta NO ACTION. Copiar la versión vigente la conserva; borrar la
  /// prestación suelta el vínculo.
  protesisId        String?
  protesis          Protesis?       @relation(fields: [protesisId, businessId], references: [id, businessId], onDelete: NoAction)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([etapaId, orden])
  @@index([appointmentId])
  @@index([protesisId])
  @@map("prestaciones_del_plan")
}

// ─── Prótesis (clínica dental, etapa 7) ─────────────────────────────────────
// Migración `20261108120000_etapa_7_protesis`. Reglas puras en
// `lib/protesis.ts`; quién ve y escribe, en `lib/permisos.ts`. Dinero en
// centavos enteros (tope 2.000.000.000) y porcentajes en puntos base
// (10.000 = 100 %), como `lib/comisiones.ts`.

/**
 * Un laboratorio (o técnico) dental externo: no tiene cuenta en Eli. Nombre
 * único en la clínica sin distinguir mayúsculas (índice único sobre
 * `lower("nombre")`, escrito a mano) y contacto opcional. No se borra: se
 * desactiva, y las prótesis que lo tienen lo siguen nombrando (copia).
 */
model Laboratorio {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre     String
  contacto   String?
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  materialesPorDefecto MaterialDeProtesis[]
  protesis             Protesis[]
  pagos                PagoAlLaboratorio[]

  // Habilita las FK compuestas (laboratorioId, businessId).
  @@unique([id, businessId])
  @@index([businessId])
  @@map("laboratorios")
}

/**
 * Un material del catálogo de prótesis, con su precio por `unidad` ("arcada":
 * removible y total; "pieza": fija, implante y corona; CHECK) y la regla de
 * reparto del valor cobrado en tres partes, en puntos base que suman 10.000
 * (CHECK). La regla se copia a la prótesis al crearla: cambiarla acá sólo
 * afecta las nuevas. Nombre único en la clínica sin mayúsculas (índice a
 * mano). No se borra: se desactiva. Lo configura sólo la dueña.
 */
model MaterialDeProtesis {
  id                      String       @id @default(cuid())
  businessId              String
  business                Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre                  String
  /// "arcada" | "pieza" (CHECK).
  unidad                  String
  /// Subconjunto no vacío de los tipos de su unidad (CHECK).
  tipos                   String[]
  precioCents             Int
  pbOdontologo            Int
  pbClinica               Int
  pbTecnico               Int
  laboratorioPorDefectoId String?
  laboratorioPorDefecto   Laboratorio? @relation(fields: [laboratorioPorDefectoId, businessId], references: [id, businessId], onDelete: NoAction)
  /// 0..999 (CHECK): el orden en que se ofrece.
  orden                   Int          @default(0)
  activo                  Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  excepciones ExcepcionDeRepartoDeProtesis[]
  protesis    Protesis[]

  @@unique([id, businessId])
  @@index([businessId])
  @@map("materiales_de_protesis")
}

/**
 * La regla de reparto de un odontólogo en un material, que manda sobre la del
 * material (como `CommissionRate` sobre el % por defecto). Una por
 * (miembro, material). FK compuestas CASCADE: sin el miembro o el material no
 * tiene sentido. Las prótesis ya creadas no la miran: copiaron la suya.
 */
model ExcepcionDeRepartoDeProtesis {
  id           String             @id @default(cuid())
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId     String
  member       BusinessMember     @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: Cascade)
  materialId   String
  material     MaterialDeProtesis @relation(fields: [materialId, businessId], references: [id, businessId], onDelete: Cascade)
  pbOdontologo Int
  pbClinica    Int
  pbTecnico    Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([memberId, materialId])
  @@index([businessId])
  @@map("excepciones_de_reparto_de_protesis")
}

/**
 * Auditoría de los cambios de reparto (docs/PRODUCTO.md §3.5): quién, cuándo,
 * de qué a qué, de la regla de un material ("material") o de una excepción
 * ("excepcion"). `anterior*` en null = no existía (se creó); `nuevo*` en null
 * = se quitó (sólo una excepción). Los ids van sin FK, como
 * `Visit.paidById`, con los nombres copiados: el registro no depende de que
 * el material, el miembro o el usuario sigan existiendo.
 */
model CambioDeRepartoDeProtesis {
  id                   String   @id @default(cuid())
  businessId           String
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// "material" | "excepcion" (CHECK).
  scope                String
  materialId           String
  materialNombre       String
  memberId             String?
  memberName           String?
  anteriorPbOdontologo Int?
  anteriorPbClinica    Int?
  anteriorPbTecnico    Int?
  nuevoPbOdontologo    Int?
  nuevoPbClinica       Int?
  nuevoPbTecnico       Int?
  changedById          String
  changedByName        String
  changedByEmail       String
  createdAt            DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("cambios_de_reparto_de_protesis")
}

/**
 * Una prótesis de un paciente: el diseño sobre la arcada (tipo, arcada,
 * piezas protésicas y pilares en FDI permanente, zonas de la base), el
 * material con su unidad y su precio copiados, el valor al paciente
 * (precio × unidades, lo calcula el servidor), el laboratorio y la entrega
 * estimada, y el seguimiento (Impresión → En laboratorio → Prueba en boca →
 * Ajustes → Entregada, sólo hacia adelante; o anulada antes de entregar).
 * El reparto (tres partes en puntos base y de dónde salió) se CONGELA al
 * crearla: cambiar después la regla del material o la excepción no la toca.
 * La tratante es un miembro (`memberId`) o la dueña (`byOwner`, sin
 * `memberId`, como `VisitService`); su nombre va copiado. Si es la dueña, su
 * parte va a la clínica (`repartoEfectivo`).
 * El trigger `protesis_congelada` sólo deja cambiar estado (hacia adelante),
 * laboratorio, entrega estimada, las fechas de entrega y anulación, y
 * desvincular a la tratante; una entregada o anulada ya no cambia. No se
 * borra (`protesis_no_se_borra`) salvo con su paciente o su negocio.
 */
model Protesis {
  id                  String             @id @default(cuid())
  businessId          String
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer           @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Cascade)
  memberId            String?
  member              BusinessMember?    @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: NoAction)
  byOwner             Boolean            @default(false)
  tratanteNombre      String
  /// removible | total | fija | implante | corona (CHECK).
  tipo                String
  /// superior | inferior | ambas (CHECK).
  arcada              String
  /// Piezas protésicas y pilares (o ganchos), FDI permanente de la arcada, sin repetir entre sí (CHECK).
  piezas              Int[]
  pilares             Int[]              @default([])
  /// paladar | lingual | flanco | rebasado | reparacion; sólo removible y total (CHECK).
  zonas               String[]           @default([])
  materialId          String
  material            MaterialDeProtesis @relation(fields: [materialId, businessId], references: [id, businessId], onDelete: NoAction)
  materialNombre      String
  unidad              String
  precioUnitarioCents Int
  /// Arcadas (1 o 2) o piezas + pilares, según la unidad (CHECK).
  unidades            Int
  /// precioUnitarioCents × unidades (CHECK), ≤ 2.000.000.000.
  valorCents          Int
  laboratorioId       String?
  laboratorio         Laboratorio?       @relation(fields: [laboratorioId, businessId], references: [id, businessId], onDelete: NoAction)
  laboratorioNombre   String?
  entregaEstimada     DateTime?          @db.Date
  /// impresion | en-laboratorio | prueba | ajustes | entregada | anulada (CHECK).
  estado              String             @default("impresion")
  pbOdontologo        Int
  pbClinica           Int
  pbTecnico           Int
  /// "material" | "excepcion" (CHECK): qué regla se congeló.
  origenDelReparto    String
  entregadaEn         DateTime?
  anuladaEn           DateTime?
  anuladaPorNombre    String?
  creadoPorNombre     String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  eventos             EventoDeProtesis[]
  prestacionesDelPlan PrestacionDelPlan[]
  abonos              VisitService[]

  @@unique([id, businessId])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, estado])
  @@map("protesis")
}

/**
 * Un paso del seguimiento de una prótesis: a qué estado pasó, cuándo y quién
 * (nombre copiado). Sólo se agregan: el trigger `eventos_de_protesis_inmutables`
 * rechaza todo UPDATE y el DELETE fuera de la cascada de su prótesis.
 */
model EventoDeProtesis {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  protesisId  String
  protesis    Protesis @relation(fields: [protesisId, businessId], references: [id, businessId], onDelete: Cascade)
  estado      String
  autorNombre String
  autorUserId String?
  createdAt   DateTime @default(now())

  @@index([protesisId, createdAt])
  @@map("eventos_de_protesis")
}

/**
 * Un pago a un laboratorio (lo usa la tanda del cobro: "Por pagar al
 * laboratorio" → "Marcar pagado"): cuánto, por qué medio, quién y cuándo. Las
 * líneas que paga quedan marcadas con su `pagoAlLaboratorioId`, como las de
 * una liquidación. No se borra: se anula (los dos datos juntos, CHECK), y
 * anularlo suelta sus líneas. FK compuesta NO ACTION al laboratorio.
 */
model PagoAlLaboratorio {
  id                String      @id @default(cuid())
  businessId        String
  business          Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  laboratorioId     String
  laboratorio       Laboratorio @relation(fields: [laboratorioId, businessId], references: [id, businessId], onDelete: NoAction)
  laboratorioNombre String
  montoCents        Int
  /// id de `lib/medios-de-pago.ts` (CHECK).
  medio             String
  pagadoEn          DateTime    @default(now())
  pagadoPorId       String
  pagadoPorNombre   String
  anuladoEn         DateTime?
  anuladoPorNombre  String?
  createdAt         DateTime    @default(now())

  lineas VisitService[]

  @@unique([id, businessId])
  @@index([businessId, laboratorioId, pagadoEn])
  @@map("pagos_al_laboratorio")
}
