generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Las sesiones iniciadas antes de este momento ya no valen: lo pone
  /// restablecer la contraseña. `lib/auth.ts` lo revisa cada 5 minutos. Null es
  /// "nunca se cerraron". Columna en camelCase y sin `@map`, como el resto del
  /// modelo (`createdAt`, `updatedAt`).
  sesionesValidasDesde DateTime?
  /// Baja de los correos del ciclo de prueba (bienvenida, consejo, avisos de
  /// fin). No afecta los correos de la cuenta (recuperar contraseña, etc.).
  correosDesactivados  Boolean   @default(false)

  business          Business?
  memberships       BusinessMember[]
  resetTokens       PasswordResetToken[]
  commissionChanges CommissionChange[] // cambios de porcentaje que este usuario (siempre dueño) aplicó.
  // Relación opcional (ver CommissionChange.changedById): la auditoría no
  // puede depender de que el usuario siga existiendo.
  solicitudesDeSoporte SolicitudDeSoporte[] // relación opcional: la solicitud queda si se borra el usuario.

  @@map("usuarios")
}

model Business {
  id        String   @id @default(cuid())
  name      String
  type      String
  slug      String   @unique
  teamSize  Int      @default(1)
  /// Zona IANA del negocio: en ella se leen sus horarios "HH:MM" y sus días
  /// (lib/zona-horaria.ts). Todavía no hay pantalla para cambiarla.
  timezone  String   @default("America/Santiago")
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cuándo termina la prueba gratis. Lo fija el código al crear el negocio
  /// (`finDeLaPrueba` en `lib/prueba.ts`) y lo corre un referido. Sin default a
  /// propósito: un `now()` mentiría; la migración rellenó createdAt + 7 días.
  pruebaTerminaEl         DateTime
  /// Si el negocio recibe los correos del ciclo de prueba. Los negocios que ya
  /// existían al agregarse quedaron en false (la migración): no se les manda una
  /// bienvenida tardía.
  recibeCorreosDePrueba   Boolean   @default(true)
  /// Cuándo se copió por primera vez el enlace de reservas (lista "Deja tu
  /// negocio listo").
  enlaceCompartidoAt      DateTime?
  /// Código del enlace de invitación: aleatorio, no adivinable y distinto del
  /// slug. Lo genera `generarCodigoInvitacion` (`lib/prueba.ts`).
  codigoInvitacion        String    @unique
  /// El negocio que invitó a éste, si llegó por un enlace de invitación.
  invitadoPorId           String?
  invitadoPor             Business? @relation("Referidos", fields: [invitadoPorId], references: [id], onDelete: SetNull)
  /// En el invitado: cuándo su primera reserva pública contó para quien lo
  /// invitó. No null = ya contó, y no vuelve a contar.
  referidoContabilizadoAt DateTime?
  /// En quien invita: cuándo recibió sus días extra por un referido. Se dan una
  /// sola vez en total por negocio.
  extensionPorReferidoAt  DateTime?

  // ─── Mini página pública (etapa 1) ──────────────────────────────────────
  // Datos que el negocio edita y que se muestran en /reservar/[slug]. Todos
  // opcionales: un negocio sin llenarlos se ve como hasta ahora.
  address     String?
  comuna      String?
  /// Número de WhatsApp del negocio, en E.164 (+56...). Lo valida la app.
  whatsapp    String?
  /// Usuario de Instagram, sin la URL.
  instagram   String?
  /// Clave de una paleta cerrada de colores; la lista válida está en la app,
  /// no en la base.
  color       String?
  logoUrl     String?
  coverUrl    String?
  /// Ids de `lib/medios-de-pago.ts` que el negocio acepta, para mostrarlos en
  /// la página pública. Vacío = no se muestra nada.
  mediosDePago String[] @default([])
  /// Hasta cuántas horas antes de la cita el cliente puede cancelar o
  /// reagendar con su enlace. Default 24; lo cambia el negocio.
  cancelacionHorasAntes Int @default(24)

  // ─── La plata del equipo (etapa 2) ──────────────────────────────────────
  /// Cada cuánto se liquida al equipo: "semanal" | "quincenal" | "mensual".
  /// Lo elige sólo la dueña (`puedeConfigurarLiquidacion`). Un CHECK de la
  /// migración limita los valores. Cambiarlo sólo afecta lo que viene.
  liquidacionPeriodo      String @default("mensual")
  /// En el período semanal, qué día empieza la semana (0 = domingo … 6 =
  /// sábado, como `WorkSchedule.dayOfWeek`). Default lunes. CHECK 0..6.
  liquidacionInicioSemana Int    @default(1)
  /// Desde qué día (del negocio, en su zona) se liquida: lo cobrado antes y
  /// los movimientos con fecha anterior nunca entran a una liquidación. Lo
  /// fija la dueña antes de la primera; null = todavía no se liquida. Se
  /// puede cambiar sólo mientras no haya liquidaciones no anuladas.
  liquidacionDesde        DateTime? @db.Date

  invitados         Business[]         @relation("Referidos")
  correosDeCuenta   CorreoDeCuenta[]
  customers         Customer[]
  appointments      Appointment[]
  services          Service[]
  workSchedules     WorkSchedule[]
  conversations     Conversation[]
  members           BusinessMember[]
  invitations       WorkerInvitation[]
  visits            Visit[]
  commissionRates   CommissionRate[]
  commissionChanges CommissionChange[]
  solicitudesDeSoporte SolicitudDeSoporte[]
  memberServices    MemberService[]
  timeBlocks        TimeBlock[]
  productos         Producto[]
  propinas          PropinaDeAtencion[]
  liquidaciones     Liquidacion[]
  movimientosDeLiquidacion MovimientoDeLiquidacion[]
  cierresDeCaja     CierreDeCaja[]

  @@index([invitadoPorId])
  @@map("negocios")
}

/// Un correo del ciclo de prueba ya enviado a un negocio ("bienvenida",
/// "consejo", "quedan-3-dias", "termina-hoy"). El único por (negocio, tipo)
/// impide registrar, y por lo tanto mandar, dos veces el mismo.
model CorreoDeCuenta {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tipo       String
  enviadoAt  DateTime @default(now())

  @@unique([businessId, tipo])
  @@map("correos_de_cuenta")
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("worker") // "admin" | "worker"
  createdAt  DateTime @default(now())

  // Porcentaje por defecto de comisión (0-100) -- el rango lo garantiza un
  // CHECK de la migración (`miembros_negocio_commissionPercent_check`), no
  // Prisma. Sin valor por defecto a propósito: `null` es "todavía no
  // configurado", no "0%". Segundo escalón de la cascada, detrás de
  // CommissionRate y delante de "pendiente de configurar".
  commissionPercent Float?

  /// Lo que se muestra del profesional en la página pública ("Colorista").
  especialidad String?
  fotoUrl      String?

  workSchedules     WorkSchedule[]
  appointments      Appointment[]
  visitServices     VisitService[]
  commissionRates   CommissionRate[]
  // Filas de auditoría donde este miembro es el auditado. La relación de
  // CommissionChange.member es simple (no compuesta) y SetNull: ver el
  // comentario en ese modelo.
  commissionChanges CommissionChange[]
  // Servicios que hace este profesional. Sin filas = hace todos.
  memberServices    MemberService[]
  timeBlocks        TimeBlock[]
  propinas          PropinaDeAtencion[]
  liquidaciones     Liquidacion[]
  movimientosDeLiquidacion MovimientoDeLiquidacion[]

  @@unique([businessId, userId])
  // Habilita la FK compuesta de CommissionRate (memberId, businessId): sin
  // esto Postgres no puede referenciar el par, y es lo único que impide que
  // una fila de comisión tenga el profesional de un negocio con el
  // businessId de otro.
  @@unique([id, businessId])
  @@index([businessId])
  @@index([userId])
  @@map("miembros_negocio")
}

model WorkerInvitation {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  name       String
  role       String    @default("worker")
  /// sha256 del token del enlace (lib/tokens.ts); el token en claro no se
  /// guarda. La columna sigue llamándose `token` para no renombrarla.
  tokenHash  String    @unique @map("token")
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
  @@map("invitaciones")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 del token del enlace (lib/tokens.ts), como `WorkerInvitation.tokenHash`.
  tokenHash String    @unique @map("token")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("tokens_recuperacion")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  lastName  String?
  cedula    String?
  email     String?
  phone     String?
  tags      String[]
  notes     String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Consentimiento para escribirle por WhatsApp: cuándo se dio y por dónde
  /// ("reserva-publica" | "panel" | "importacion"; los valida la app). Null =
  /// sin consentimiento registrado.
  whatsappConsentAt     DateTime?
  whatsappConsentSource String?

  appointments Appointment[]
  visits       Visit[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@map("clientes")
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  duration    Int // en minutos: 15, 30, 45, 60, 90, 120...
  price       Float?
  /// Categoría libre para agrupar en la página pública ("Corte", "Color").
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments      Appointment[]
  visitServices     VisitService[]
  commissionRates   CommissionRate[]
  // Filas de auditoría con este servicio como excepción puntual. Relación
  // simple (no compuesta) y SetNull: ver el comentario en CommissionChange.
  commissionChanges CommissionChange[]
  memberServices    MemberService[]

  // Habilita la FK compuesta de CommissionRate (serviceId, businessId), igual
  // que en BusinessMember.
  @@unique([id, businessId])
  @@index([businessId])
  @@map("servicios")
}

model WorkSchedule {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId   String?
  member     BusinessMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Domingo, 1=Lunes, 2=Martes, 3=Miércoles, 4=Jueves, 5=Viernes, 6=Sábado
  startTime  String // "09:00"
  endTime    String // "18:00"
  active     Boolean         @default(true)

  @@index([businessId])
  @@index([memberId])
  @@map("horarios_laborales")
}

model Appointment {
  id               String   @id @default(cuid())
  serviceId        String?
  service          Service? @relation(fields: [serviceId], references: [id])
  title            String   // nombre del servicio como texto libre o copia del servicio
  startTime        DateTime
  endTime          DateTime
  status           String   @default("pendiente") // pendiente, confirmada, en-progreso, completada, cancelada, no-asistio (sin CHECK: lo valida la app)
  // Quién creó la cita: "panel" (el equipo del negocio) o "reserva-publica"
  // (la página /reservar/[slug]). Los topes anti-abuso de la reserva pública
  // cuentan por esta columna (`lib/reserva-publica.ts`). En la base, una CHECK
  // la limita a esos dos valores (migración `origen_de_las_citas`).
  source           String   @default("panel")
  notes            String?  // notas internas del profesional
  clientComments   String?  // comentarios del cliente al reservar
  price            Float?
  // La columna sigue llamándose `patientId` en la base (de cuando Eli apuntaba a
  // consultorios). Renombrarla pide una migración sobre datos reales; el `@map`
  // deja el nombre claro en el código sin tocar la tabla.
  customerId       String?         @map("patientId")
  customer         Customer?       @relation(fields: [customerId], references: [id])
  memberId         String?
  member           BusinessMember? @relation(fields: [memberId], references: [id])
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // SIN USO desde la etapa 2: la comisión se congela por línea, en
  // `VisitService` (commissionPercent/commissionCents/commissionAt), porque una
  // cita puede tener varias líneas de distintos profesionales. Estas columnas
  // quedan vacías y no se borran (borrarlas es una migración destructiva que
  // no hace falta). Lo que sigue es su diseño original.
  //
  // Comisión congelada al completar la cita. Todavía no hay código que la
  // calcule: estas columnas son sólo el lugar donde va a quedar. Se escriben
  // una sola vez y no se recalculan: cambiar un porcentaje después no puede
  // alterar una cita ya liquidada. Opcionales sin valor por defecto a propósito, por la misma
  // razón que en BusinessMember/CommissionRate: `null` tiene que poder
  // significar "todavía no tiene comisión resuelta", nunca "0".
  //
  // Los tres son NULL juntos o NOT NULL juntos: lo garantiza un CHECK de la
  // migración (`citas_comision_congelada_check`), no Prisma. Sin esto, una
  // cita podría quedar con `commissionAmount = 0` y `commissionPercent = NULL`
  // ("pendiente de configurar") y liquidarse como si valiera cero sin que
  // nadie lo note.
  //
  // `commissionAmount` es `Decimal`, no `Float`: es dinero que se va a sumar
  // sobre decenas de citas en cada liquidación mensual, y el punto flotante
  // acumula error de redondeo en cada suma -- eso son disputas con gente que
  // cobra por su trabajo. Se decide ahora porque la columna nace vacía
  // (se agrega en esta misma migración) y esa ventana no se repite:
  // convertir un `Float` a `Decimal` con datos ya cargados es una migración
  // aparte, con `USING` y riesgo de reescritura de tabla. `Decimal(12, 2)`:
  // 2 decimales es la escala universal para dinero (centavos/céntimos), y 12
  // dígitos totales (hasta 9.999.999.999,99) da margen amplio para el monto
  // de una única cita en cualquier moneda con la que trabaje un negocio,
  // sin ser un tamaño arbitrario/desperdiciado (Postgres sólo ocupa espacio
  // por los dígitos que el valor realmente tiene, no por la precisión
  // declarada). `Appointment.price` y `Service.price` **no** se tocan acá:
  // siguen en `Float` a propósito porque ya tienen datos en producción y los
  // usa mucho código; pasarlos a `Decimal` es un cambio de otra escala y con
  // otro plan de prueba (sobre una base con datos, no vacía).
  //
  // `commissionPercent` (acá y en BusinessMember/CommissionRate) se queda en
  // `Float`, a propósito y no por descuido: un porcentaje es un valor
  // independiente por fila, no algo que se sume repetidamente como
  // `commissionAmount` en una liquidación -- no hay superficie para que un
  // error de redondeo se acumule. El error de representación de un `Float`
  // de doble precisión es del orden de 1e-15, muy por debajo de cualquier
  // precisión de porcentaje que el producto vaya a pedir (ni siquiera define
  // decimales para el porcentaje). Pasarlo a `Decimal` tampoco evitaría la
  // mezcla de tipos al calcular (`price` sigue siendo `Float`): esa conversión
  // haría falta igual en el momento del cálculo, la tenga `percent` el tipo
  // que tenga, y la tiene que resolver quien escriba ese cálculo.
  commissionPercent Float? // porcentaje ya resuelto por la cascada al momento del cálculo -- rango 0-100 vía CHECK
  commissionAmount  Decimal?  @db.Decimal(12, 2) // monto resultante, sobre el precio total sin descontar insumos
  commissionAt      DateTime? // cuándo se calculó y congeló

  // Enlace para que el cliente cancele o reagende sin cuenta. Se guarda el
  // sha256 del token (lib/tokens.ts), nunca el token en claro, como en
  // `WorkerInvitation.tokenHash`. Null = la cita no tiene enlace.
  manageTokenHash String?   @unique
  // Quién canceló: "cliente" | "negocio" (lo valida la app) y cuándo. Null en
  // las citas no canceladas y en las canceladas antes de existir la columna.
  canceladaPor    String?
  canceladaEn     DateTime?
  // Cuándo se mandó el recordatorio. No null = ya salió y no se repite.
  reminderSentAt  DateTime?

  // La atención que nació de esta reserva, si el cliente ya llegó.
  visit Visit?

  @@index([businessId])
  @@index([businessId, startTime])
  // Consulta de liquidación: businessId + memberId + status + rango de fechas.
  // La liquidación todavía no existe; el índice se crea junto con las columnas.
  @@index([businessId, memberId, startTime])
  @@index([customerId])
  @@index([memberId])
  @@map("citas")
}

// ─── Tablero de atenciones (docs/PRODUCTO.md, sección 7) ────────────────────
//
// La cita es lo planeado; la atención es lo que de verdad se hizo y se cobró.
// Es historial de dinero: por eso copia los nombres (cliente, servicio,
// profesional) en vez de depender de que esos registros sigan existiendo, y
// sus relaciones con el resto del negocio son opcionales y quedan en null si
// el otro lado se borra. Lo único que arrastra a una atención es borrar el
// negocio entero.
model Visit {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String // copia: el historial se lee igual aunque el cliente se borre
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  // En la base, además, una CHECK lo limita a los cinco de `lib/atenciones.ts`.
  status        String       @default("en-espera") // en-espera, en-atencion, por-cobrar, finalizada, anulada
  notes         String?
  arrivedAt     DateTime     @default(now())
  startedAt     DateTime?
  readyAt       DateTime?
  paidAt        DateTime?
  voidedAt      DateTime?
  voidReason    String?
  // En centavos enteros, como todo el dinero de estas tres tablas: un `Float`
  // guarda 0,1 + 0,2 como 0,30000000000000004, y el cobro se compara al
  // centavo. La API sigue hablando en unidades; se convierte en el borde
  // (`aCentavos`/`deCentavos`). Los topes que impiden desbordar el `Int` están
  // en `lib/atenciones.ts`.
  //
  // Se congela al cobrar y no se recalcula nunca más. Mientras la atención
  // está abierta queda en null: el total vivo es la suma de las líneas.
  //
  // Prisma no representa restricciones CHECK en este archivo: las del dinero
  // (total, precios y pagos) y la del estado están escritas a mano al final de
  // la migración del tablero. Son la segunda barrera, porque no hay RLS.
  totalCents    Int?
  // Ids de `User` SIN relación, a propósito. Con una FK, borrar al usuario
  // obligaría a poner estas columnas en null (o a impedir el borrado) y se
  // perdería quién cobró o anuló algo ya cobrado: justo el dato que hace falta
  // para resolver una discusión sobre dinero. Por eso nadie puede navegar de
  // acá al usuario con Prisma: el id se guarda como registro, no como vínculo.
  createdById   String?
  paidById      String?
  voidedById    String?
  // Copia del nombre de quien cobró y de quien anuló, como `professionalName`
  // en las líneas: el id solo se resuelve mientras la persona siga en el
  // negocio, y si se va, el historial tiene que seguir diciendo quién fue.
  paidByName    String?
  voidedByName  String?

  services VisitService[]
  payments VisitPayment[]
  propinas PropinaDeAtencion[]
  movimientosDeLiquidacion MovimientoDeLiquidacion[]

  // Habilita las FK compuestas (visitId, businessId) de las propinas y de los
  // movimientos de liquidación, como en BusinessMember.
  @@unique([id, businessId])
  @@index([businessId, status])
  @@index([businessId, paidAt])
  @@index([customerId])
  @@map("atenciones")
}

// Una línea de la atención: qué servicio se hizo, quién lo hizo y a qué precio.
// Es la base de las comisiones (sección 3).
model VisitService {
  id               String          @id @default(cuid())
  visitId          String
  visit            Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName      String // copia del nombre del catálogo al anotarla
  memberId         String?
  member           BusinessMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  // El dueño no es `BusinessMember`, así que su línea se marca acá y lleva
  // `memberId` en null. Nunca se usa un `memberId` nulo para decir "dueño": al
  // borrar a un miembro, su `memberId` queda en null, y esa línea pasaría a
  // leerse como del dueño. Con la marca aparte, una línea sin `memberId` y sin
  // `byOwner` es de alguien que ya no está en el equipo, y se lee como tal.
  byOwner          Boolean         @default(false)
  professionalName String // copia del nombre de quien la hizo
  priceCents       Int // centavos enteros, como `Visit.totalCents`

  /// "servicio" | "producto" (CHECK). Una línea de producto lleva `productId`
  /// y no `serviceId`; una de servicio, al revés (CHECK). `serviceName` guarda
  /// el nombre copiado en los dos casos. Un producto vendido dos veces son dos
  /// líneas: no hay cantidad.
  tipo      String    @default("servicio")
  productId String?
  product   Producto? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Comisión congelada por línea al cobrar (#65). Reemplaza a las columnas
  // de `citas`, que quedan sin uso. Los tres en null = pendiente (sin % al
  // cobrar), nunca 0; los tres juntos o ninguno (CHECK). Las líneas `byOwner`
  // nunca llevan comisión (CHECK). Una vez congelada no cambia: lo impide el
  // trigger `atencion_servicios_comision_inmutable` de la migración.
  commissionPercent Float? // 0-100 vía CHECK
  commissionCents   Int? // 0..priceCents vía CHECK
  commissionAt      DateTime?

  /// La liquidación que ya pagó esta línea. Con valor, el trigger impide
  /// cambiarle precio, profesional o comisión. FK simple: la línea no tiene
  /// `businessId` propio (va por la atención).
  liquidacionId String?
  liquidacion   Liquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: NoAction)

  @@index([visitId])
  @@index([memberId])
  @@index([productId])
  @@index([memberId, liquidacionId])
  @@map("atencion_servicios")
}

// Un pago de la atención. Un cobro se puede repartir entre varios medios
// (`lib/medios-de-pago.ts`); la suma coincide con el total al centavo.
model VisitPayment {
  id          String   @id @default(cuid())
  visitId     String
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  method      String // id de `lib/medios-de-pago.ts`: efectivo, tarjeta-debito, ...
  amountCents Int // centavos enteros, como `Visit.totalCents`
  createdAt   DateTime @default(now())

  @@index([visitId])
  @@map("atencion_pagos")
}

/**
 * Un producto que vende el negocio (shampoo, cera). Sin inventario: sólo el
 * nombre, el precio sugerido y el % de comisión de quien lo vende. El catálogo
 * lo gestionan dueña y encargado; el % sólo la dueña (`lib/permisos.ts`).
 * `commissionPercent` null es "sin configurar", no 0, como en BusinessMember.
 */
model Producto {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  priceCents        Int? // centavos; 0..2e9 vía CHECK
  commissionPercent Float? // 0-100 vía CHECK; null = pendiente
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  visitServices     VisitService[]
  commissionChanges CommissionChange[]

  @@unique([id, businessId])
  @@index([businessId])
  @@map("productos")
}

/**
 * Una propina de una atención (#66). Tabla propia y no `VisitPayment`: la
 * propina no es ingreso del negocio, así que no puede sumar en el tablero ni
 * en los reportes. Va 100 % al profesional y se paga en la liquidación; la de
 * la dueña (`byOwner`) no entra a ninguna (CHECK).
 *
 * FK compuestas contra (id, businessId), como CommissionRate: Postgres rechaza
 * una propina que mezcle la atención o el miembro de otro negocio. Los
 * miembros con NO ACTION y no SetNull: SetNull en una compuesta anularía
 * también `businessId`.
 */
model PropinaDeAtencion {
  id               String          @id @default(cuid())
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visitId          String
  visit            Visit           @relation(fields: [visitId, businessId], references: [id, businessId], onDelete: Cascade)
  memberId         String?
  member           BusinessMember? @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: NoAction)
  /// Como en `VisitService`: la dueña no es miembro. O `byOwner` o `memberId`, nunca los dos ni ninguno (CHECK).
  byOwner          Boolean         @default(false)
  professionalName String // copia del nombre
  method           String // id de `lib/medios-de-pago.ts`
  amountCents      Int // > 0 y ≤ 2e9 vía CHECK
  liquidacionId    String?
  liquidacion      Liquidacion?    @relation(fields: [liquidacionId, businessId], references: [id, businessId], onDelete: NoAction)
  createdAt        DateTime        @default(now())

  @@index([visitId])
  @@index([businessId, memberId, liquidacionId])
  @@map("atencion_propinas")
}

/**
 * Lo que se le paga a un profesional por un período (#68), congelado al
 * cerrar: los montos son un snapshot y no se recalculan. Las líneas, propinas
 * y movimientos incluidos quedan marcados con su `liquidacionId`. Anularla
 * (sólo cerrada, no pagada) los libera.
 *
 * `desde` y `hasta` son días del negocio (incluidos los dos), en su `zona`.
 * Una sola liquidación no anulada por (negocio, miembro, desde): índice único
 * parcial escrito a mano en la migración. Los ids de `User` (cerradaPorId…)
 * van sin FK, como `Visit.paidById`, con el nombre copiado al lado.
 */
model Liquidacion {
  id                     String         @id @default(cuid())
  businessId             String
  business               Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId               String
  member                 BusinessMember @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: NoAction)
  memberName             String
  /// "semanal" | "quincenal" | "mensual" (CHECK), el vigente al cerrar.
  periodo                String
  desde                  DateTime       @db.Date
  hasta                  DateTime       @db.Date
  zona                   String
  /// "cerrada" | "pagada" | "anulada" (CHECK).
  estado                 String         @default("cerrada")
  comisionServiciosCents Int
  comisionProductosCents Int
  propinasCents          Int
  adelantosCents         Int // adelantos y vales: descuentan
  ajustesCents           Int // con signo
  brutoCents             Int // comisiones + propinas
  totalCents             Int // bruto − adelantos ± ajustes; ≥ 0 (CHECK): no se cierra en negativo
  cerradaAt              DateTime       @default(now())
  cerradaPorId           String
  cerradaPorNombre       String
  pagadaAt               DateTime?
  pagadaPorId            String?
  pagadaPorNombre        String?
  medioDePago            String?
  anuladaAt              DateTime?
  anuladaPorId           String?
  anuladaPorNombre       String?
  motivoAnulacion        String?
  nota                   String?

  lineas      VisitService[]
  propinas    PropinaDeAtencion[]
  movimientos MovimientoDeLiquidacion[]

  @@unique([id, businessId])
  @@index([businessId, memberId, desde])
  @@map("liquidaciones")
}

/**
 * Adelantos y vales (descuentan) y ajustes (con signo, con motivo) de un
 * profesional, que entran en su próxima liquidación. Adelantos y vales los
 * registran dueña y encargado; ajustes, sólo la dueña. No se borran: se
 * anulan, y uno anulado no puede estar en una liquidación (CHECK).
 */
model MovimientoDeLiquidacion {
  id               String         @id @default(cuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId         String
  member           BusinessMember @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: NoAction)
  memberName       String
  /// "adelanto" | "vale" | "ajuste" (CHECK).
  tipo             String
  /// Adelanto y vale: > 0. Ajuste: ≠ 0, con signo. Tope 2e9 (CHECK).
  montoCents       Int
  fecha            DateTime       @db.Date
  /// Obligatorio para un ajuste (lo exige la app).
  motivo           String?
  /// La atención que corrige un ajuste, si corrige una.
  visitId          String?
  visit            Visit?         @relation(fields: [visitId, businessId], references: [id, businessId], onDelete: NoAction)
  liquidacionId    String?
  liquidacion      Liquidacion?   @relation(fields: [liquidacionId, businessId], references: [id, businessId], onDelete: NoAction)
  anuladoAt        DateTime?
  anuladoPorId     String?
  anuladoPorNombre String?
  createdById      String
  createdByName    String
  createdAt        DateTime       @default(now())

  @@index([businessId, memberId, liquidacionId])
  @@map("movimientos_de_liquidacion")
}

/**
 * Un cierre de caja (#71). Cubre (desde, hasta]: desde es el `hasta` del
 * cierre anterior (o el inicio del día del negocio) y hasta, el momento del
 * cierre. Varios por día. Los montos son un snapshot; un cierre no se edita.
 * Las CHECK de la migración garantizan esperado = fondo + cobrado + propinas
 * y diferencia = contado − esperado. `desglose`: otros medios, informativo.
 */
model CierreDeCaja {
  id                    String   @id @default(cuid())
  businessId            String
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  desde                 DateTime
  hasta                 DateTime
  /// El día del negocio del cierre, en su `zona`.
  fecha                 DateTime @db.Date
  zona                  String
  fondoInicialCents     Int
  efectivoCobradoCents  Int
  propinasEfectivoCents Int
  efectivoEsperadoCents Int
  efectivoContadoCents  Int
  diferenciaCents       Int
  desglose              Json     @default("{}")
  /// Obligatoria si la diferencia no es 0 (lo exige la app).
  nota                  String?
  cerradoPorId          String
  cerradoPorNombre      String
  createdAt             DateTime @default(now())

  @@unique([businessId, hasta])
  @@index([businessId, desde])
  @@map("cierres_de_caja")
}

/**
 * Excepción de comisión para un profesional en un servicio puntual. Primer
 * escalón de la cascada (regla 1 de docs/PRODUCTO.md §3.1): si existe una fila
 * para (memberId, serviceId), gana sobre `BusinessMember.commissionPercent`.
 * Modelo "con herencia": no hace falta una fila por cada combinación
 * profesional × servicio, sólo donde hay una excepción real.
 * `member` y `service` usan FK compuesta contra `(id, businessId)` del
 * profesional y del servicio, no contra `id` solo. Sin esto, Postgres acepta
 * una fila con el `businessId` de un negocio y el `memberId`/`serviceId` de
 * otro (nada las relaciona entre sí), y es exactamente el caso que
 * `findUnique(memberId_serviceId)` -- la resolución de la cascada -- no puede
 * filtrar por negocio: aplicaría el porcentaje de otro negocio a una cita, y
 * quedaría congelado. La FK compuesta hace que Postgres rechace el insert
 * directamente.
 */
model CommissionRate {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId   String
  member     BusinessMember @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: Cascade)
  serviceId  String
  // Restrict, no Cascade: borrar un servicio con comisiones configuradas debe
  // fallar, no arrastrarlas en silencio. `puedeGestionarServicios` incluye al
  // encargado, pero `puedeEditarComisiones` es sólo del dueño -- con Cascade,
  // el encargado borra un servicio y de paso borra los porcentajes de
  // comisión de todos los profesionales para ese servicio, sin pasar nunca
  // por un permiso de comisiones. Restrict cierra ese atajo en la base, no
  // sólo en la app. Es un cambio real de comportamiento, no la formalización
  // de algo que ya pasaba: `Appointment.service` es `ON DELETE SET NULL`
  // (migración init, línea 161), o sea que hoy borrar un servicio con
  // historial funciona. A partir de acá, borrar uno con comisiones
  // configuradas falla; quien quiera hacerlo primero quita esas filas de
  // `CommissionRate`, o lo desactiva con `Service.active` sin borrarlo (el
  // endpoint devuelve 409 con esa explicación).
  service    Service        @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict)
  percent    Float // 0-100 -- rango vía CHECK de la migración, no Prisma. Nunca tiene default: la fila sólo existe si alguien la configuró.
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Sin esto, dos porcentajes para la misma combinación hacen la cascada no
  // determinista. También es la clave que usa la resolución en cascada
  // (findUnique por memberId_serviceId), así que de paso queda indexada.
  @@unique([memberId, serviceId])
  @@index([businessId])
  @@map("porcentajes_comision")
}

/**
 * Qué servicios hace cada profesional. Un profesional SIN filas acá hace todos
 * los servicios del negocio (así funcionaba antes, y así siguen los que ya
 * existen); con al menos una fila, hace sólo esos.
 * `member` y `service` usan FK compuesta contra `(id, businessId)`, como en
 * `CommissionRate`: Postgres rechaza una fila que mezcle el profesional o el
 * servicio de un negocio con el `businessId` de otro. Cascade en las tres: la
 * fila no tiene sentido sin el profesional o sin el servicio.
 */
model MemberService {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId   String
  member     BusinessMember @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: Cascade)
  serviceId  String
  service    Service        @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([memberId, serviceId])
  @@index([businessId])
  @@map("member_services")
}

/**
 * Un bloqueo de horario: un rango en que no se puede agendar. Con `memberId`
 * bloquea sólo a ese profesional (vacaciones, trámite); con `memberId` null
 * bloquea todo el negocio (feriado, cierre). Que `endTime` sea mayor que
 * `startTime` lo garantiza un CHECK de la migración, no Prisma.
 * `member` usa FK compuesta contra `(id, businessId)`, como `CommissionRate`;
 * con `memberId` null Postgres no la revisa (MATCH SIMPLE), que es justo el
 * bloqueo de todo el negocio.
 */
model TimeBlock {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberId   String?
  member     BusinessMember? @relation(fields: [memberId, businessId], references: [id, businessId], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  motivo     String?
  // Id de `User` SIN relación, como `Visit.createdById`: el registro de quién
  // lo creó no debe depender de que el usuario siga existiendo.
  createdById String?
  createdAt  DateTime        @default(now())

  @@index([businessId, startTime])
  @@index([memberId, startTime])
  @@map("time_blocks")
}

/**
 * Auditoría de cambios de porcentaje (docs/PRODUCTO.md §3.5): quién, cuándo, de
 * qué valor a qué valor. `scope` dice a qué aplicó el cambio ("default" = al
 * porcentaje por defecto del profesional, "service" = a una excepción
 * puntual) y es explícito: no se infiere de si `serviceId` es null, porque
 * `serviceId` puede volverse null por SetNull al borrarse el servicio, y ese
 * mismo valor es el que usa la cascada para decir "sin excepción". Si el
 * significado dependiera de `serviceId`, borrar un servicio reescribiría en
 * silencio "cambié la excepción de Juan en Color" por "cambié el porcentaje
 * por defecto de Juan" -- la auditoría no quedaría incompleta, quedaría
 * mintiendo, y no habría forma de distinguir un registro adulterado de uno
 * legítimo. `serviceName` es un snapshot del nombre del servicio al momento
 * del cambio, para que el registro siga siendo legible si el servicio se
 * borra (sólo tiene sentido cuando `scope = "service"`).
 * `memberId` y `changedById` son nullable con SetNull, y `memberName` /
 * `changedByName` / `changedByEmail` son snapshots tomados al crear la fila.
 * Una tabla de auditoría no puede cascadear con lo que audita: si
 * `changedById` cascadeara, borrar al usuario borraría el registro de los
 * cambios que hizo; si `memberId` cascadeara, dar de baja a un profesional
 * borraría todo su historial de comisiones justo cuando más se necesita (una
 * baja es cuando aparecen las disputas). SetNull + snapshot hace que la fila
 * sobreviva siempre, legible, aunque lo auditado desaparezca.
 * Ninguna de las dos relaciones usa la FK compuesta de `CommissionRate`
 * (`(id, businessId)`): una FK compuesta con `onDelete: SetNull` anula TODAS
 * las columnas de la constraint a la vez, incluida `businessId` -- y
 * `businessId` acá es NOT NULL (aislamiento entre negocios: toda fila debe poder
 * filtrarse por negocio), así que esa combinación o rompe el insert o vuelve
 * la fila invisible para cualquier consulta multi-tenant. Quedan como FK
 * simples contra `.id`; el negocio se resuelve siempre escribiendo el
 * `businessId` del actor de sesión al crear la fila, igual que en el resto
 * del código (nunca del cliente). `changedById` tampoco admite FK compuesta
 * por otra razón: `usuarios` no tiene `businessId` (el dueño no es miembro del
 * negocio). Sólo el dueño puede generar estas filas (`lib/permisos.ts`,
 * `puedeEditarComisiones`), por eso quien cambia es un `User` y no un
 * `BusinessMember`.
 */
model CommissionChange {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  memberId   String?
  member     BusinessMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberName String // snapshot del nombre del profesional al momento del cambio

  scope       String // "default" | "service" | "product" -- explícito, no inferido de serviceId (ver comentario del modelo)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String? // snapshot; sólo aplica cuando scope = "service"
  // Como serviceId/serviceName, para el % de un producto (scope = "product").
  productId   String?
  product     Producto? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String? // snapshot; sólo aplica cuando scope = "product"

  changedById    String?
  changedBy      User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedByName  String // snapshot
  changedByEmail String // snapshot

  // `null` en cualquiera de los dos es "no estaba configurado" (no es lo mismo
  // que 0), igual que en los campos que audita. Rango 0-100 vía CHECK.
  previousPercent Float?
  newPercent      Float?

  createdAt DateTime @default(now())

  // Multi-tenant: todo índice empieza por businessId. Sirve tanto para
  // "auditoría del negocio" como, con el prefijo, para "auditoría de este
  // profesional en este negocio".
  @@index([businessId, memberId, createdAt])
  @@map("cambios_comision")
}

model Conversation {
  id            String    @id @default(cuid())
  // Mismo caso que `Appointment.customerId`: las columnas conservan su nombre.
  customerName  String    @map("patientName")
  customerPhone String?   @map("patientPhone")
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages Message[]

  @@index([businessId])
  @@map("conversaciones")
}

model Message {
  id             String       @id @default(cuid())
  content        String
  fromBusiness   Boolean
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("mensajes")
}

/// Una solicitud de soporte (falla, reclamo o consulta) hecha desde
/// /dashboard/ayuda o desde la página pública /soporte. Se guarda antes de
/// mandar los correos: si el envío falla, el caso queda igual. Los valores
/// válidos de `tipo` y `area` están en `lib/soporte.ts`.
model SolicitudDeSoporte {
  id           String    @id @default(cuid())
  /// Número de caso que ve la persona ("#000123", `formatearNumeroDeCaso`).
  numero       Int       @unique @default(autoincrement())
  tipo         String
  area         String
  asunto       String
  descripcion  String
  /// Texto libre: en qué pantalla o URL pasó.
  dondeOcurrio String?
  /// Con sesión salen de la cuenta, no del formulario; sin sesión los escribe
  /// la persona.
  nombre       String
  email        String
  /// Con sesión, el negocio de la sesión (nunca uno que mande el cliente). Si
  /// se borra el negocio o el usuario, la solicitud queda sin el vínculo.
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  estado       String    @default("recibida")
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([businessId])
  @@index([userId])
  @@map("solicitudes_de_soporte")
}
