{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Edit(app/**)",
      "Edit(components/**)",
      "Edit(lib/**)",
      "Edit(hooks/**)",
      "Edit(types/**)",
      "Edit(styles/**)",
      "Edit(prisma/**)",
      "Edit(docs/**)",
      "Edit(public/**)",
      "Edit(middleware.ts)",
      "Edit(next.config.mjs)",
      "Edit(vitest.config.ts)",
      "Edit(eslint.config.mjs)",
      "Edit(package.json)",
      "Edit(.env.example)",
      "Edit(CLAUDE.md)",

      "Write(app/**)",
      "Write(components/**)",
      "Write(lib/**)",
      "Write(hooks/**)",
      "Write(types/**)",
      "Write(prisma/**)",
      "Write(docs/**)",

      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma migrate diff *)",
      "Bash(npx prisma migrate status)",

      "Bash(git *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(find *)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db push *)",
      "Bash(npx prisma db execute *)",
      "Bash(npx prisma migrate deploy *)",

      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git push --force *)",

      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(.env)",
      "Edit(.env)"
    ]
  }
}
