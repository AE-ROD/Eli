{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Edit(app/**)",
      "Edit(components/**)",
      "Edit(lib/**)",
      "Edit(hooks/**)",
      "Edit(types/**)",
      "Edit(styles/**)",
      "Edit(prisma/**)",
      "Edit(docs/**)",
      "Edit(public/**)",
      "Edit(middleware.ts)",
      "Edit(next.config.mjs)",
      "Edit(vitest.config.ts)",
      "Edit(eslint.config.mjs)",
      "Edit(package.json)",
      "Edit(.env.example)",
      "Edit(CLAUDE.md)",

      "Write(app/**)",
      "Write(components/**)",
      "Write(lib/**)",
      "Write(hooks/**)",
      "Write(types/**)",
      "Write(prisma/**)",
      "Write(docs/**)",

      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma migrate diff *)",
      "Bash(npx prisma migrate status)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(find *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(gh *)",
      "Bash(hub *)",

      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db push *)",
      "Bash(npx prisma db execute *)",
      "Bash(npx prisma migrate deploy *)",

      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(.env)",
      "Edit(.env)"
    ]
  }
}
